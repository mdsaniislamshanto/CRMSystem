@model IEnumerable<CRMSystem.Models.ViewModels.UserViewModel>





<!-- User Table -->
<div class="card shadow-sm border-0">

    <div class="card-body">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>

                        <th>Employee Code</th>

                        <th>Name</th>

                        <th>Email</th>

                        <th>Phone</th>

                        <th>Role</th>

                        <th>Status</th>

                        <th>Email Verified</th>

                        <th>Last Login</th>

                        <th width="180">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>@user.EmployeeCode</td>

                                <td>@user.FullName</td>

                                <td>@user.Email</td>

                                <td>@user.PhoneNumber</td>

                                <td>@user.RoleName</td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success px-3 py-2">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>

                                <td>

                                    @if (user.IsEmailVerified)
                                    {
                                        <span class="badge bg-success">
                                            Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Not Verified
                                        </span>
                                    }

                                </td>

                                <td>

                                    @(user.LastLoginAt?.ToString("dd MMM yyyy hh:mm tt") ?? "Never")

                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-warning"
                                       title="Edit User">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-info text-white"
                                       title="View Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <form asp-action="ToggleStatus"
                                          asp-route-id="@user.UserId"
                                          method="post"
                                          class="d-inline">

                                        <button type="button"
                                                class="btn btn-sm @(user.IsActive ? "btn-danger" : "btn-success")"
                                                title="@(user.IsActive ? "Deactivate User" : "Activate User")"
                                                onclick="confirmToggle(this)">

                                            <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8" class="text-center py-4">

                                <i class="bi bi-people fs-1 text-secondary d-block mb-2"></i>

                                <h5>No users found.</h5>

                                <p class="text-muted mb-0">
                                    Click <strong>Add User</strong> to create your first user.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>