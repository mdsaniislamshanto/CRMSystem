@model CRMSystem.Models.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
    ViewData["Breadcrumb"] = "Users / Edit";
    Layout = "_AdminLayout";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Edit User
        </h2>

        <p class="text-muted mb-0">
            Update user information and assigned role.
        </p>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="UserId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Employee Code -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeCode"
                               class="form-label">
                        </label>

                        <input asp-for="EmployeeCode"
                               class="form-control"
                               readonly />

                    </div>

                    <!-- Email -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />

                    </div>

                    <!-- First Name -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="FirstName"
                               class="form-label">
                        </label>

                        <input asp-for="FirstName"
                               class="form-control" />

                        <span asp-validation-for="FirstName"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Last Name -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="LastName"
                               class="form-label">
                        </label>

                        <input asp-for="LastName"
                               class="form-control" />

                        <span asp-validation-for="LastName"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Phone -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Role -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="RoleId"
                               class="form-label">
                        </label>

                        <select asp-for="RoleId"
                                asp-items="Model.Roles"
                                class="form-select">
                        </select>

                        <span asp-validation-for="RoleId"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>

                        Update User

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}