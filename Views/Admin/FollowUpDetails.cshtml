@model CRMSystem.Models.ViewModels.SalesManagerFollowUpDetailsViewModel

@{
    ViewData["Title"] = "Follow-up Details";
    ViewData["Breadcrumb"] = "Follow-up Details";
    Layout = "_AdminLayout";
}

<style>

    /* =========================================
               Page
               ========================================= */

    .followup-details-page {
        padding: 2rem 1.5rem 3rem;
        background: #f7f9fc;
        min-height: calc(100vh - 70px);
    }


    /* =========================================
               Page Header
               ========================================= */

    .details-header {
        margin-bottom: 1.5rem;
    }

        .details-header h2 {
            font-size: 1.65rem;
            font-weight: 700;
            color: #172033;
            margin-bottom: .35rem;
        }

        .details-header p {
            color: #6b7280;
            margin-bottom: 0;
            font-size: .9rem;
        }


    /* =========================================
               Back Button
               ========================================= */

    .back-btn {
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        padding: .5rem .8rem;
    }


    /* =========================================
               Lead Information Card
               ========================================= */

    .lead-info-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(25, 42, 70, .04);
        margin-bottom: 1.5rem;
    }

        .lead-info-card .card-body {
            padding: 1.25rem 1.35rem;
        }

    .info-label {
        color: #7a8496;
        font-size: .72rem;
        margin-bottom: .25rem;
    }

    .lead-title {
        color: #172033;
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: .15rem;
    }

    .lead-id {
        color: #98a2b3;
        font-size: .72rem;
    }

    .officer-name {
        color: #344054;
        font-size: .88rem;
        font-weight: 600;
    }


    /* =========================================
               Feedback History Card
               ========================================= */

    .history-container {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(25, 42, 70, .04);
        overflow: hidden;
    }

    .history-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #edf0f4;
    }

    .history-title {
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .history-title-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: #edf4ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .history-title h5 {
        margin: 0;
        color: #172033;
        font-size: 1rem;
        font-weight: 700;
    }

    .history-count {
        background: #edf4ff;
        color: #2563eb;
        border: 1px solid #dce9ff;
        border-radius: 20px;
        padding: .35rem .65rem;
        font-size: .7rem;
        font-weight: 600;
    }


    /* =========================================
               Feedback Card
               ========================================= */

    .feedback-card {
        border: 1px solid #e5e9f0;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(25, 42, 70, .03);
        transition: box-shadow .2s ease, transform .2s ease;
    }

        .feedback-card:hover {
            box-shadow: 0 5px 16px rgba(25, 42, 70, .06);
        }


    /* =========================================
               Feedback Header
               ========================================= */

    .feedback-card-header {
        background: #f8fafc;
        border-bottom: 1px solid #e8edf4;
        padding: .8rem 1rem;
    }

    .feedback-number {
        color: #172033;
        font-size: .84rem;
        font-weight: 700;
    }

        .feedback-number i {
            color: #667085;
        }


    /* =========================================
               Feedback Status Badge
               ========================================= */

    .feedback-status-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .32rem .6rem;
        border-radius: 20px;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
        color: #667085;
        font-size: .66rem;
        font-weight: 600;
        white-space: nowrap;
    }


    /* =========================================
               Feedback Body
               ========================================= */

    .feedback-card-body {
        padding: 1rem;
    }

    .feedback-field-label {
        color: #7a8496;
        font-size: .7rem;
        font-weight: 500;
        margin-bottom: .3rem;
    }

    .feedback-date {
        color: #344054;
        font-size: .82rem;
        font-weight: 600;
    }

    .feedback-time {
        color: #98a2b3;
        font-size: .7rem;
    }


    /* =========================================
               Follow-up Status
               ========================================= */

    .followup-status-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        border-radius: 20px;
        padding: .34rem .62rem;
        font-size: .67rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .followup-overdue {
        color: #c62828;
        background: #fff0f1;
        border: 1px solid #ffd5d8;
    }

    .followup-upcoming {
        color: #18794e;
        background: #edf9f3;
        border: 1px solid #d4f0e1;
    }

    .followup-none {
        color: #667085;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
    }


    /* =========================================
               Last Feedback Timing
               ========================================= */

    .feedback-timing-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .34rem .65rem;
        border-radius: 20px;
        font-size: .67rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .timing-on-time {
        color: #18794e;
        background: #edf9f3;
        border: 1px solid #d4f0e1;
    }

    .timing-late {
        color: #c62828;
        background: #fff0f1;
        border: 1px solid #ffd5d8;
    }

    .timing-na {
        color: #667085;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
    }


    /* =========================================
               Summary / Notes
               ========================================= */

    .content-box {
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 8px;
        padding: .85rem .95rem;
        color: #475467;
        font-size: .82rem;
        line-height: 1.55;
    }


    /* =========================================
               Proof / Attachments
               ========================================= */

    .attachment-btn {
        border-radius: 7px;
        font-size: .72rem;
        font-weight: 600;
    }


    /* =========================================
               Empty State
               ========================================= */

    .empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
    }

    .empty-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: #f2f5f9;
        color: #98a2b3;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.4rem;
    }

    .empty-state h6 {
        color: #344054;
        font-weight: 700;
    }

    .empty-state p {
        color: #98a2b3;
        font-size: .82rem;
        margin-bottom: 0;
    }


    /* =========================================
               Responsive
               ========================================= */

    @@media (max-width: 767.98px) {

        .followup-details-page {
            padding: 1.25rem .85rem 2rem;
        }

        .details-header {
            align-items: flex-start !important;
            flex-direction: column;
            gap: 1rem;
        }

        .feedback-card-body {
            padding: .85rem;
        }
    }

</style>


<div class="followup-details-page">

    <!-- =========================================
         Page Header
         ========================================= -->

    <div class="details-header d-flex justify-content-between align-items-center">

        <div>

            <h2>
                Follow-up Details
            </h2>

            <p>
                Complete feedback history for this lead.
            </p>

        </div>

        <div>

            <a asp-controller="SalesManager"
               asp-action="FollowUps"
               class="btn btn-outline-secondary back-btn">

                <i class="bi bi-arrow-left me-1"></i>

                Back to Follow-ups

            </a>

        </div>

    </div>


    <!-- =========================================
         Lead Information
         ========================================= -->

    <div class="lead-info-card">

        <div class="card-body">

            <div class="row align-items-center">

                <!-- Lead -->

                <div class="col-md-6">

                    <div class="info-label">
                        Lead
                    </div>

                    <div class="lead-title">
                        @Model.LeadName
                    </div>

                    <div class="lead-id">
                        Lead ID: @Model.LeadId
                    </div>

                </div>


                <!-- Sales Officer -->

                <div class="col-md-6 text-md-end mt-3 mt-md-0">

                    <div class="info-label">
                        Sales Officer
                    </div>

                    <div class="officer-name">

                        <i class="bi bi-person me-1"></i>

                        @Model.SalesOfficerName

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         Feedback History
         ========================================= -->

    <div class="history-container">

        <!-- History Header -->

        <div class="history-header">

            <div class="d-flex justify-content-between align-items-center">

                <div class="history-title">

                    <div class="history-title-icon">

                        <i class="bi bi-clock-history"></i>

                    </div>

                    <h5>
                        Feedback History
                    </h5>

                </div>


                <span class="history-count">

                    <i class="bi bi-chat-left-text me-1"></i>

                    @Model.FeedbackHistory.Count Feedback(s)

                </span>

            </div>

        </div>


        <!-- History Body -->

        <div class="p-3">

            @if (!Model.FeedbackHistory.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-chat-square-text"></i>

                    </div>

                    <h6>
                        No Feedback Found
                    </h6>

                    <p>
                        No feedback has been submitted for this lead yet.
                    </p>

                </div>
            }
            else
            {
                <div class="row">

                    @foreach (var feedback in Model.FeedbackHistory)
                    {
                        <div class="col-12 mb-4">

                            <div class="feedback-card">

                                <!-- =================================
                                     Feedback Header
                                     ================================= -->

                                <div class="feedback-card-header">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <div class="feedback-number">

                                            <i class="bi bi-chat-left-text me-1"></i>

                                            Feedback #@feedback.FeedbackId

                                        </div>


                                        <span class="feedback-status-badge">

                                            <i class="bi bi-chat-square-text"></i>

                                            @feedback.FeedbackStatus

                                        </span>

                                    </div>

                                </div>


                                <!-- =================================
                                     Feedback Body
                                     ================================= -->

                                <div class="feedback-card-body">

                                    <div class="row g-4">

                                        <!-- =================================
                                             Submitted At
                                             ================================= -->

                                        <div class="col-md-4">

                                            <div class="feedback-field-label">
                                                Submitted At
                                            </div>

                                            <div class="feedback-date">

                                                @feedback.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")

                                            </div>

                                            <div class="feedback-time">

                                                @feedback.SubmittedAt.ToLocalTime().ToString("hh:mm tt")

                                            </div>

                                        </div>


                                        <!-- =================================
                                             Next Follow-up
                                             ================================= -->

                                        <div class="col-md-4">

                                            <div class="feedback-field-label">
                                                Next Follow-up
                                            </div>

                                            @if (feedback.NextFollowUpDate.HasValue)
                                            {
                                                <div class="feedback-date">

                                                    @feedback.NextFollowUpDate.Value.ToLocalTime().ToString("dd MMM yyyy")

                                                </div>

                                                <div class="feedback-time">

                                                    @feedback.NextFollowUpDate.Value.ToLocalTime().ToString("hh:mm tt")

                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    Not scheduled
                                                </span>
                                            }

                                        </div>


                                        <!-- =================================
                                             Follow-up Status
                                             ================================= -->

                                        <div class="col-md-4">

                                            <div class="feedback-field-label">
                                                Follow-up Status
                                            </div>

                                            @if (feedback.NextFollowUpDate.HasValue)
                                            {
                                                @if (feedback.IsNextFollowUpOverdue)
                                                {
                                                    <span class="followup-status-badge followup-overdue">

                                                        <i class="bi bi-exclamation-circle-fill"></i>

                                                        Overdue

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="followup-status-badge followup-upcoming">

                                                        <i class="bi bi-calendar-check-fill"></i>

                                                        Upcoming

                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="followup-status-badge followup-none">

                                                    <i class="bi bi-dash-circle"></i>

                                                    No Follow-up

                                                </span>
                                            }

                                        </div>


                                        <!-- =================================
                                             Last Feedback Timing
                                             ================================= -->

                                        <div class="col-md-4">

                                            <div class="feedback-field-label">
                                                Last Feedback Timing
                                            </div>

                                            @if (feedback.LastFeedbackTiming == "On Time")
                                            {
                                                <span class="feedback-timing-badge timing-on-time">

                                                    <i class="bi bi-check-circle-fill"></i>

                                                    On Time

                                                </span>
                                            }
                                            else if (feedback.LastFeedbackTiming == "Late")
                                            {
                                                <span class="feedback-timing-badge timing-late">

                                                    <i class="bi bi-exclamation-circle-fill"></i>

                                                    Late

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="feedback-timing-badge timing-na">

                                                    <i class="bi bi-dash-circle"></i>

                                                    N/A

                                                </span>
                                            }

                                        </div>


                                        <!-- =================================
                                             Summary
                                             ================================= -->

                                        <div class="col-12">

                                            <div class="feedback-field-label">
                                                Summary
                                            </div>

                                            <div class="content-box">

                                                @if (!string.IsNullOrWhiteSpace(feedback.Summary))
                                                {
                                                    @feedback.Summary
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        No summary provided.
                                                    </span>
                                                }

                                            </div>

                                        </div>


                                        <!-- =================================
                                             Notes
                                             ================================= -->
                                        @if (!string.IsNullOrWhiteSpace(feedback.Notes))
                                        {
                                            <div class="col-12">

                                                <div class="feedback-field-label">
                                                    Additional Notes
                                                </div>

                                                <div class="content-box">

                                                    @feedback.Notes

                                                </div>

                                            </div>
                                        }


                                        <!-- =================================
                                             Proof / Attachments
                                             ================================= -->

                                        <div class="col-12">

                                            <div class="feedback-field-label mb-2">
                                                Proof / Attachments
                                            </div>

                                            <div class="d-flex flex-wrap gap-2">

                                                <!-- Proof Image -->
                                                @if (!string.IsNullOrWhiteSpace(feedback.ProofImage))
                                                {
                                                    <a href="@feedback.ProofImage"
                                                       target="_blank"
                                                       class="btn btn-sm btn-outline-primary attachment-btn">

                                                        <i class="bi bi-image me-1"></i>

                                                        View Proof Image

                                                    </a>
                                                }


                                                <!-- Voice Recording -->
                                                @if (!string.IsNullOrWhiteSpace(feedback.VoiceRecording))
                                                {
                                                    <a href="@feedback.VoiceRecording"
                                                       target="_blank"
                                                       class="btn btn-sm btn-outline-success attachment-btn">

                                                        <i class="bi bi-mic me-1"></i>

                                                        Open Voice Recording

                                                    </a>
                                                }


                                                <!-- No Proof -->
                                                @if (string.IsNullOrWhiteSpace(feedback.ProofImage)
                                                                                                    && string.IsNullOrWhiteSpace(feedback.VoiceRecording))
                                                {
                                                    <span class="text-muted small">

                                                        <i class="bi bi-paperclip me-1"></i>

                                                        No proof attached.

                                                    </span>
                                                }

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>