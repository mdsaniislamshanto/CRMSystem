@model CRMSystem.Models.ViewModels.EditTargetViewModel

@{
    ViewData["Title"] = "Edit Sales Manager Target";
    ViewData["Breadcrumb"] = "Sales Targets / Edit";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- =====================================================
         Page Header
         ===================================================== -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Edit Sales Manager Target
        </h2>

        <p class="text-muted mb-0">
            Update target count or period for @Model.UserName.
        </p>

    </div>


    <!-- =====================================================
         Form Card
         ===================================================== -->

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">

                    <h5 class="fw-bold mb-1">
                        Edit Target Details
                    </h5>

                    <p class="text-muted small mb-0">
                        Modify target count or period below.
                    </p>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Admin"
                          asp-action="EditTarget"
                          method="post"
                          autocomplete="off">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="TargetId" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="UserName" />
                        <input type="hidden" asp-for="UserRole" />

                        <!-- Validation Summary -->

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- =================================================
                             Sales Manager (Read-only Display)
                             ================================================= -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Sales Manager
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.UserName"
                                   readonly
                                   style="background-color: #e9ecef;" />

                            <div class="form-text">
                                Target recipient cannot be changed. To assign a target to another manager, create a new target.
                            </div>

                        </div>


                        <!-- =================================================
                             Period + Target Count
                             ================================================= -->

                        <div class="row">

                            <!-- Target Period -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="PeriodType"
                                       class="form-label fw-semibold">

                                    Target Period

                                </label>

                                <select asp-for="PeriodType"
                                        class="form-select"
                                        id="PeriodType">

                                    <option value="1">
                                        Weekly (7 Days)
                                    </option>

                                    <option value="2">
                                        Monthly (1 Month)
                                    </option>

                                </select>

                                <span asp-validation-for="PeriodType"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Target Count -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="TargetCount"
                                       class="form-label fw-semibold">

                                    Target Count

                                </label>

                                <div class="input-group">

                                    <input asp-for="TargetCount"
                                           type="number"
                                           min="1"
                                           class="form-control"
                                           placeholder="e.g. 50" />

                                    <span class="input-group-text">
                                        Leads
                                    </span>

                                </div>

                                <span asp-validation-for="TargetCount"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             Date Range (Editable)
                             ================================================= -->

                        <div class="row">

                            <!-- Start Date -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="StartDate"
                                       class="form-label fw-semibold">

                                    Start Date

                                </label>

                                <input asp-for="StartDate"
                                       type="date"
                                       id="StartDate"
                                       class="form-control" />

                                <span asp-validation-for="StartDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- End Date -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="EndDate"
                                       class="form-label fw-semibold">

                                    End Date

                                </label>

                                <input asp-for="EndDate"
                                       type="date"
                                       id="EndDate"
                                       class="form-control" />

                                <span asp-validation-for="EndDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-12 mb-3">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    You can manually select or adjust the Start Date and End Date as needed.
                                </small>
                            </div>

                        </div>


                        <!-- =================================================
                             Information Box
                             ================================================= -->

                        <div class="alert alert-info border-0">

                            <div class="d-flex">

                                <div class="me-3">

                                    <i class="bi bi-info-circle fs-5">
                                    </i>

                                </div>

                                <div>

                                    <strong>
                                        Editing Active Target
                                    </strong>

                                    <div class="small mt-1">

                                        Modifying this target will adjust the goal for the current active period. Completed leads in this period will count against the updated goal.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             Buttons
                             ================================================= -->

                        <div class="d-flex
                            justify-content-end
                            gap-2
                            mt-4">

                            <a asp-controller="Admin"
                               asp-action="Targets"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left me-1"></i>

                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-circle me-1"></i>

                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const periodSelect = document.getElementById("PeriodType");
            const startDateInput = document.getElementById("StartDate");
            const endDateInput = document.getElementById("EndDate");
            const form = document.querySelector("form");

            function formatDate(d) {
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            function updateEndDateOnPeriodChange() {
                const val = periodSelect.value;
                if (!startDateInput.value) return;

                const parts = startDateInput.value.split('-');
                if (parts.length !== 3) return;
                const start = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));

                if (val === "1" || val === "Weekly") {
                    const end = new Date(start);
                    end.setDate(end.getDate() + 7);
                    endDateInput.value = formatDate(end);
                } else if (val === "2" || val === "Monthly") {
                    const end = new Date(start);
                    end.setMonth(end.getMonth() + 1);
                    endDateInput.value = formatDate(end);
                }
            }

            if (periodSelect) {
                periodSelect.addEventListener("change", updateEndDateOnPeriodChange);
            }

            if (form) {
                form.addEventListener("submit", function (e) {
                    if (startDateInput.value && endDateInput.value) {
                        if (startDateInput.value > endDateInput.value) {
                            e.preventDefault();
                            alert("Start date cannot be after end date.");
                            return false;
                        }
                    }
                });
            }
        });
    </script>
}
