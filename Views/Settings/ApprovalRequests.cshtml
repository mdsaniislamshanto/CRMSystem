@model CRMSystem.Models.ViewModels.AdminApprovalViewModel

@{
    ViewData["Title"] = "Approval Requests";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">

    <!-- =====================================================
         Page Header
         ===================================================== -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Approval Requests
        </h2>

        <p class="text-muted mb-0">
            Review and manage pending requests from
            Sales Managers and Sales Officers.
        </p>

    </div>


    <!-- =====================================================
         Success Message
         ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- =====================================================
         Error Message
         ===================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- =====================================================
         Profile Change Requests
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between
                align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-person-gear me-2"></i>

                        Profile Change Requests

                    </h5>

                    <p class="text-muted mb-0">

                        Review Name, Phone and Email change
                        requests.

                    </p>

                </div>


                <span class="badge bg-primary rounded-pill">

                    @Model.ProfileChangeRequests.Count
                    Pending

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!Model.ProfileChangeRequests.Any())
            {
                <div class="p-4 text-center text-muted">

                    <i class="bi bi-check-circle fs-2 d-block mb-2"></i>

                    No pending profile change requests.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4">
                                    Employee
                                </th>

                                <th>
                                    Field
                                </th>

                                <th>
                                    Current Value
                                </th>

                                <th>
                                    Requested Value
                                </th>

                                <th>
                                    Requested At
                                </th>

                                <th class="text-end px-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var request
                                in Model.ProfileChangeRequests)
                            {
                                <tr>

                                    <!-- Employee -->

                                    <td class="px-4">

                                        <div class="fw-semibold">

                                            @request.UserName

                                        </div>

                                        <small class="text-muted">

                                            @request.EmployeeCode

                                        </small>

                                    </td>


                                    <!-- Field -->

                                    <td>

                                        <span class="badge bg-info text-dark">

                                            @request.FieldName

                                        </span>

                                    </td>


                                    <!-- Current Value -->

                                    <td>

                                        <span class="text-muted">

                                            @(string.IsNullOrWhiteSpace(
                                                request.OldValue)
                                                ? "—"
                                                : request.OldValue)

                                        </span>

                                    </td>


                                    <!-- Requested Value -->

                                    <td>

                                        <span class="fw-semibold">

                                            @(string.IsNullOrWhiteSpace(
                                                request.NewValue)
                                                ? "—"
                                                : request.NewValue)

                                        </span>

                                    </td>


                                    <!-- Requested At -->

                                    <td>

                                        @request.RequestedAt
                                        .ToLocalTime()
                                        .ToString(
                                        "dd MMM yyyy, hh:mm tt")

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end px-4">

                                        <div class="d-flex
                                            justify-content-end
                                            gap-2">

                                            <!-- Approve -->

                                            <form asp-controller="Settings"
                                                  asp-action="ApproveProfileChange"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="requestId"
                                                       value="@request.RequestId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">

                                                    <i class="bi bi-check-lg me-1"></i>

                                                    Approve

                                                </button>

                                            </form>


                                            <!-- Reject -->

                                            <form asp-controller="Settings"
                                                  asp-action="RejectProfileChange"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="requestId"
                                                       value="@request.RequestId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                    <i class="bi bi-x-lg me-1"></i>

                                                    Reject

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         Auto Assignment Requests
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between
                align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-arrow-repeat me-2"></i>

                        Auto Assignment Requests

                    </h5>

                    <p class="text-muted mb-0">

                        Review Sales Manager Auto Assignment
                        ON/OFF requests.

                    </p>

                </div>


                <span class="badge bg-primary rounded-pill">

                    @Model.AutoAssignmentRequests.Count
                    Pending

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!Model.AutoAssignmentRequests.Any())
            {
                <div class="p-4 text-center text-muted">

                    <i class="bi bi-check-circle fs-2 d-block mb-2"></i>

                    No pending Auto Assignment requests.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4">
                                    Sales Manager
                                </th>

                                <th>
                                    Requested Change
                                </th>

                                <th>
                                    Requested At
                                </th>

                                <th class="text-end px-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var request
                                in Model.AutoAssignmentRequests)
                            {
                                <tr>

                                    <!-- Sales Manager -->

                                    <td class="px-4">

                                        <div class="fw-semibold">

                                            @request.SalesManagerName

                                        </div>

                                        <small class="text-muted">

                                            @request.EmployeeCode

                                        </small>

                                    </td>


                                    <!-- Requested Status -->

                                    <td>

                                        @if (request.RequestedStatus)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-toggle-on me-1"></i>

                                                Enable Auto Assignment

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                <i class="bi bi-toggle-off me-1"></i>

                                                Disable Auto Assignment

                                            </span>
                                        }

                                    </td>


                                    <!-- Requested At -->

                                    <td>

                                        @request.RequestedAt
                                        .ToLocalTime()
                                        .ToString(
                                        "dd MMM yyyy, hh:mm tt")

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end px-4">

                                        <div class="d-flex
                                            justify-content-end
                                            gap-2">

                                            <!-- Approve -->

                                            <form asp-controller="Settings"
                                                  asp-action="ApproveAutoAssignment"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="requestId"
                                                       value="@request.RequestId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">

                                                    <i class="bi bi-check-lg me-1"></i>

                                                    Approve

                                                </button>

                                            </form>


                                            <!-- Reject -->

                                            <form asp-controller="Settings"
                                                  asp-action="RejectAutoAssignment"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="requestId"
                                                       value="@request.RequestId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                    <i class="bi bi-x-lg me-1"></i>

                                                    Reject

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         Back Button
         ===================================================== -->

    <div class="mb-4">

        <a asp-controller="Settings"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Settings

        </a>

    </div>

</div>