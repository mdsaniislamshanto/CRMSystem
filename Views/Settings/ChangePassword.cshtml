@model CRMSystem.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Change Password
        </h2>

        <p class="text-muted mb-0">
            Update your account password securely.
        </p>

    </div>


    <!-- Password Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <form asp-controller="Settings"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- Current Password -->
                <div class="mb-3">

                    <label asp-for="CurrentPassword"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="CurrentPassword"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Enter current password" />

                    <span asp-validation-for="CurrentPassword"
                          class="text-danger">
                    </span>

                </div>


                <!-- New Password -->
                <div class="mb-3">

                    <label asp-for="NewPassword"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="NewPassword"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Enter new password" />

                    <span asp-validation-for="NewPassword"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Password must be at least 8 characters long.
                    </small>

                </div>


                <!-- Confirm Password -->
                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Confirm new password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>


                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-shield-lock me-1"></i>

                        Change Password

                    </button>


                    <a asp-controller="Settings"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}