@model CRMSystem.Models.ViewModels.AdminReportViewModel

@{
    ViewData["Title"] = "Reports";
    ViewData["Breadcrumb"] = "Reports";
    Layout = "_AdminLayout";

    var total = Model.TotalLeads;

    double completedPercentage =
        total > 0
            ? (double)Model.CompletedLeads / total * 100
            : 0;

    double inProgressPercentage =
        total > 0
            ? (double)Model.InProgressLeads / total * 100
            : 0;

    double rejectedPercentage =
        total > 0
            ? (double)Model.RejectedLeads / total * 100
            : 0;
}

<div class="container-fluid mt-4">

    <!-- =====================================================
         Page Header
         ===================================================== -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Reports
        </h2>

        <p class="text-muted mb-0">
            Monitor lead performance, sales officer activity and lead sources.
        </p>

    </div>


    <!-- =====================================================
         Lead Summary
         ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Total Leads
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalLeads
                            </h3>

                        </div>

                        <div class="text-primary fs-2">

                            <i class="bi bi-people-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- New Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                New Leads
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.NewLeads
                            </h3>

                        </div>

                        <div class="text-info fs-2">

                            <i class="bi bi-plus-circle-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Assigned Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Assigned Leads
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.AssignedLeads
                            </h3>

                        </div>

                        <div class="text-warning fs-2">

                            <i class="bi bi-person-check-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Unassigned Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Unassigned Leads
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.UnassignedLeads
                            </h3>

                        </div>

                        <div class="text-danger fs-2">

                            <i class="bi bi-person-x-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         Status Summary
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-0">
                Lead Status Summary
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- Accepted -->

                <div class="col-md-3">

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Accepted
                        </span>

                        <strong>
                            @Model.AcceptedLeads
                        </strong>

                    </div>

                    <div class="progress"
                         style="height: 8px;">

                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @(total > 0 ? (double)Model.AcceptedLeads / total * 100 : 0)%">
                        </div>

                    </div>

                </div>


                <!-- In Progress -->

                <div class="col-md-3">

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            In Progress
                        </span>

                        <strong>
                            @Model.InProgressLeads
                        </strong>

                    </div>

                    <div class="progress"
                         style="height: 8px;">

                        <div class="progress-bar bg-warning"
                             role="progressbar"
                             style="width: @(inProgressPercentage)%">
                        </div>

                    </div>

                </div>


                <!-- Completed -->

                <div class="col-md-3">

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Completed
                        </span>

                        <strong>
                            @Model.CompletedLeads
                        </strong>

                    </div>

                    <div class="progress"
                         style="height: 8px;">

                        <div class="progress-bar bg-primary"
                             role="progressbar"
                             style="width: @(completedPercentage)%">
                        </div>

                    </div>

                </div>


                <!-- Rejected -->

                <div class="col-md-3">

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Rejected
                        </span>

                        <strong>
                            @Model.RejectedLeads
                        </strong>

                    </div>

                    <div class="progress"
                         style="height: 8px;">

                        <div class="progress-bar bg-danger"
                             role="progressbar"
                             style="width: @(rejectedPercentage)%">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         Sales Officer Performance
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Sales Officer Performance
                    </h5>

                    <p class="text-muted mb-0 small">
                        Lead activity by Sales Officer.
                    </p>

                </div>

                <i class="bi bi-person-workspace fs-3 text-primary"></i>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                Employee Code
                            </th>

                            <th>
                                Sales Officer
                            </th>

                            <th class="text-center">
                                Assigned
                            </th>

                            <th class="text-center">
                                Accepted
                            </th>

                            <th class="text-center">
                                In Progress
                            </th>

                            <th class="text-center">
                                Completed
                            </th>

                            <th class="text-center">
                                Rejected
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.SalesOfficerReports == null ||
                             !Model.SalesOfficerReports.Any())
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-4 text-muted">

                                    <i class="bi bi-person-x fs-3 d-block mb-2"></i>

                                    No Sales Officer data available.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var officer in Model.SalesOfficerReports)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @officer.EmployeeCode
                                        </strong>

                                    </td>

                                    <td>
                                        @officer.FullName
                                    </td>

                                    <td class="text-center">

                                        <span class="badge bg-primary">
                                            @officer.AssignedLeads
                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <span class="badge bg-success">
                                            @officer.AcceptedLeads
                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <span class="badge bg-warning text-dark">
                                            @officer.InProgressLeads
                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <span class="badge bg-info text-dark">
                                            @officer.CompletedLeads
                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <span class="badge bg-danger">
                                            @officer.RejectedLeads
                                        </span>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         Lead Source Summary
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Lead Source Summary
                    </h5>

                    <p class="text-muted mb-0 small">
                        Distribution of leads by source.
                    </p>

                </div>

                <i class="bi bi-bar-chart-fill fs-3 text-primary"></i>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Lead Source
                            </th>

                            <th class="text-center">
                                Lead Count
                            </th>

                            <th style="width: 40%;">
                                Distribution
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.LeadSourceReports == null ||
                             !Model.LeadSourceReports.Any())
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center py-4 text-muted">

                                    <i class="bi bi-bar-chart fs-3 d-block mb-2"></i>

                                    No lead source data available.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var source in Model.LeadSourceReports)
                            {
                                var percentage =
                                    total > 0
                                        ? (double)source.LeadCount / total * 100
                                        : 0;

                                <tr>

                                    <!-- Lead Source -->

                                    <td style="width: 30%;">

                                        <strong>
                                            @source.Source
                                        </strong>

                                    </td>


                                    <!-- Lead Count -->

                                    <td class="text-center"
                                        style="width: 15%;">

                                        <span class="badge bg-primary">
                                            @source.LeadCount
                                        </span>

                                    </td>


                                    <!-- Distribution -->

                                    <td style="width: 55%;">

                                        <div class="source-distribution">

                                            <div class="source-progress">

                                                <div class="source-progress-bar"
                                                     style="width: @(percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;">
                                                </div>

                                            </div>

                                            <span class="source-percentage">
                                                @percentage.ToString("0.0")%
                                            </span>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<style>

    .source-distribution {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        min-height: 32px;
    }

    .source-progress {
        flex: 1;
        height: 8px;
        min-height: 8px;
        background-color: #e9ecef;
        border-radius: 10px;
        overflow: hidden;
    }

    .source-progress-bar {
        height: 100%;
        min-height: 8px;
        background-color: #0d6efd;
        border-radius: 10px;
        transition: width 0.3s ease;
    }

    .source-percentage {
        min-width: 48px;
        text-align: right;
        font-size: 0.85rem;
        color: #6c757d;
    }

    .table > tbody > tr > td {
        vertical-align: middle;
    }

</style>