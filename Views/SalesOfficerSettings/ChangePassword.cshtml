@model CRMSystem.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_SalesOfficerLayout";
}

<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Change Password
        </h2>

        <p class="text-muted mb-0">
            Update your account password securely.
        </p>

    </div>


    <!-- Error Summary -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm">

            <div asp-validation-summary="ModelOnly"></div>

        </div>
    }


    <!-- Change Password Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="row">

                <div class="col-lg-8 col-xl-7">

                    <form asp-controller="SalesOfficerSettings"
                          asp-action="ChangePassword"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Current Password -->
                        <div class="mb-3">

                            <label asp-for="CurrentPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="CurrentPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Enter current password" />

                            <span asp-validation-for="CurrentPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- New Password -->
                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Enter new password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Confirm Password -->
                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Confirm new password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-key-fill me-1"></i>

                                Change Password

                            </button>


                            <a asp-controller="SalesOfficerSettings"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- Security Information -->
    <div class="alert alert-info mt-4 shadow-sm">

        <div class="d-flex">

            <i class="bi bi-shield-lock-fill me-2"></i>

            <div>

                <strong>Password Security</strong>

                <p class="mb-0 mt-1">

                    Choose a strong password and do not share
                    it with anyone.

                </p>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}