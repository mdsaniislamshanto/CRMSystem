@model CRMSystem.Models.ViewModels.AssignLeadViewModel

@{
    ViewData["Title"] = "Assign Lead";
    Layout = "_AdminLayout";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                Assign Lead
            </h4>

        </div>

        <div class="card-body">

            <form asp-action="Assign" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="LeadId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Lead Code
                    </label>

                    <input asp-for="LeadCode"
                           class="form-control"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Lead Name
                    </label>

                    <input asp-for="LeadName"
                           class="form-control"
                           readonly />

                </div>

                <div class="mb-3">

                    <label asp-for="SalesOfficerId"
                           class="form-label">
                    </label>

                    <select asp-for="SalesOfficerId"
                            asp-items="Model.SalesOfficers"
                            class="form-select">

                        <option value="">
                            -- Select Sales Officer --
                        </option>

                    </select>

                    <span asp-validation-for="SalesOfficerId"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex justify-content-end">

                    <a asp-action="Index"
                       class="btn btn-secondary me-2">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-person-check-fill"></i>

                        Assign Lead

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}