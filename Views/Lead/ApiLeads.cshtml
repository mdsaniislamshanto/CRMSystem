@using CRMSystem.Constants
@using CRMSystem.Enums
@using Microsoft.AspNetCore.Http
@model CRMSystem.Models.ViewModels.ApiLeadFilterViewModel

@{
    ViewData["Title"] = "API Leads";

    var currentRole =
        Context.Session.GetString(SessionKeys.RoleKey);

    if (currentRole == "SALES_MANAGER")
    {
        Layout = "_SalesManagerLayout";
    }
    else
    {
        Layout = "_AdminLayout";
    }
}


<div class="container-fluid py-4">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-1">

                <h2 class="fw-bold mb-0">
                    API Leads
                </h2>

            </div>

            <p class="text-muted mb-0">
                Manage leads captured automatically from external API sources.
            </p>

        </div>

    </div>


    <!-- =====================================================
         SEARCH & FILTERS
    ====================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <form asp-controller="Lead"
                  asp-action="ApiLeads"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Search -->

                    <div class="col-xl-5 col-lg-5">

                        <label class="form-label fw-semibold">
                            Search Leads
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@Model.Search"
                                   class="form-control"
                                   placeholder="Lead name, company, email, phone or code..." />

                        </div>

                    </div>


                    <!-- Source -->

                    <div class="col-xl-2 col-lg-2">

                        <label class="form-label fw-semibold">
                            Source
                        </label>

                        <select name="source"
                                class="form-select">

                            <option value="">
                                All Sources
                            </option>

                            @foreach (var item in Enum.GetValues<LeadSource>())
                            {
                                if (Model.Source == item)
                                {
                                    <option value="@item" selected>
                                        @item
                                    </option>
                                }
                                else
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Status -->

                    <div class="col-xl-2 col-lg-2">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            @foreach (var item in Enum.GetValues<LeadStatus>())
                            {
                                if (Model.Status == item)
                                {
                                    <option value="@item" selected>
                                        @item
                                    </option>
                                }
                                else
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Search -->

                    <div class="col-xl-1 col-lg-1">

                        <button type="submit"
                                class="btn btn-primary w-100"
                                title="Search">

                            <i class="bi bi-search"></i>

                        </button>

                    </div>


                    <!-- Clear -->

                    <div class="col-xl-2 col-lg-2">

                        <a asp-controller="Lead"
                           asp-action="ApiLeads"
                           class="btn btn-outline-secondary w-100">

                            <i class="bi bi-x-circle me-1"></i>

                            Clear

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY CARDS
    ====================================================== -->

    <div class="row g-4 mb-4">


        <!-- Total API Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-1">
                                Total API Leads
                            </div>

                            <h2 class="fw-bold mb-0">
                                @Model.Leads.Count
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-primary">

                            <i class="bi bi-cloud-arrow-down"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- New Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-1">
                                New Leads
                            </div>

                            <h2 class="fw-bold mb-0 text-success">
                                @Model.Leads.Count(x =>
                                    x.Status == LeadStatus.New)
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-warning">

                            <i class="bi bi-person-plus-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Assigned Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-1">
                                Assigned Leads
                            </div>

                            <h2 class="fw-bold mb-0">
                                @Model.Leads.Count(x =>
                                    x.Status == LeadStatus.Assigned ||
                                    x.Status == LeadStatus.Accepted ||
                                    x.Status == LeadStatus.InProgress)
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-success">

                            <i class="bi bi-person-check-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Completed -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-1">
                                Completed
                            </div>

                            <h2 class="fw-bold mb-0">
                                @Model.Leads.Count(x =>
                                    x.Status == LeadStatus.Completed)
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-info">

                            <i class="bi bi-check-circle-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         API LEADS TABLE
    ====================================================== -->

    <div class="card border-0 shadow-sm">

        <!-- Card Header -->

        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-1 fw-semibold">
                        API Captured Leads
                    </h5>

                    <small class="text-muted">
                        Leads automatically captured from external sources.
                    </small>

                </div>


                <span class="badge bg-primary rounded-pill px-3 py-2">

                    @Model.Leads.Count

                    Leads

                </span>

            </div>

        </div>


        <!-- Table -->

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                #
                            </th>

                            <th>
                                Lead
                            </th>

                            <th>
                                Company
                            </th>

                            <th>
                                Contact
                            </th>

                            <th>
                                Source
                            </th>

                            <th>
                                Priority
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Assigned To
                            </th>

                            <th>
                                Created
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Leads.Count > 0)
                        {
                            var index = 1;

                            foreach (var lead in Model.Leads)
                            {
                                <tr>

                                    <!-- Serial -->

                                    <td class="ps-4">
                                        @index
                                    </td>


                                    <!-- Lead -->

                                    <td>

                                        <div class="fw-semibold">
                                            @lead.LeadName
                                        </div>

                                        <small class="text-muted">
                                            @lead.LeadCode
                                        </small>

                                    </td>


                                    <!-- Company -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(lead.CompanyName)
                                            ? "-"
                                            : lead.CompanyName)

                                    </td>


                                    <!-- Contact -->

                                    <td>

                                        <div>

                                            <i class="bi bi-telephone me-1"></i>

                                            @lead.Phone

                                        </div>

                                        <div class="small text-muted">

                                            <i class="bi bi-envelope me-1"></i>

                                            @(string.IsNullOrWhiteSpace(lead.Email)
                                                ? "-"
                                                : lead.Email)

                                        </div>

                                    </td>


                                    <!-- Source -->

                                    <td>

                                        <span class="badge bg-primary">

                                            @lead.Source

                                        </span>

                                    </td>


                                    <!-- Priority -->

                                    <td>

                                        @if (lead.Priority == LeadPriority.High)
                                        {
                                            <span class="badge bg-danger">
                                                High
                                            </span>
                                        }
                                        else if (lead.Priority == LeadPriority.Medium)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Medium
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Low
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (lead.Status == LeadStatus.New)
                                        {
                                            <span class="badge bg-primary">
                                                New
                                            </span>
                                        }
                                        else if (lead.Status == LeadStatus.Assigned)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Assigned
                                            </span>
                                        }
                                        else if (lead.Status == LeadStatus.Accepted)
                                        {
                                            <span class="badge bg-info">
                                                Accepted
                                            </span>
                                        }
                                        else if (lead.Status == LeadStatus.InProgress)
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else if (lead.Status == LeadStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }

                                    </td>


                                    <!-- Assigned To -->

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(lead.AssignedTo))
                                        {
                                            <span class="text-muted">
                                                Unassigned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">
                                                @lead.AssignedTo
                                            </span>
                                        }

                                    </td>


                                    <!-- Created -->

                                    <td>

                                        <div>
                                            @lead.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @lead.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                        </small>

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <!-- Details -->

                                            <a asp-controller="Lead"
                                               asp-action="Details"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View Lead">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->

                                            <a asp-controller="Lead"
                                               asp-action="Edit"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Edit Lead">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Assign/Reassign -->
                                            @if (lead.Status == LeadStatus.New ||
                                                                                             lead.Status == LeadStatus.Rejected)
                                            {
                                                <a asp-controller="Lead"
                                                   asp-action="Assign"
                                                   asp-route-id="@lead.LeadId"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Assign Lead">

                                                    <i class="bi bi-person-check"></i>

                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Lead"
                                                   asp-action="Assign"
                                                   asp-route-id="@lead.LeadId"
                                                   class="btn btn-sm btn-outline-warning"
                                                   title="Reassign Lead">

                                                    <i class="bi bi-arrow-repeat"></i>

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>

                                index++;
                            }
                        }
                        else
                        {
                            <!-- Empty State -->

                            <tr>

                                <td colspan="10"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-cloud-slash fs-1 d-block mb-3"></i>

                                        <h5 class="fw-semibold">
                                            No API Leads Found
                                        </h5>

                                        <p class="mb-0">
                                            No leads have been captured from API sources yet.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>