@model CRMSystem.Models.ViewModels.ApiLeadFilterViewModel

@{
    ViewData["Title"] = "API Leads";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                API Leads
            </h2>

            <p class="text-muted mb-0">
                Manage leads captured automatically from external API sources.
            </p>

        </div>

        <div>

            <a asp-controller="GoogleForms"
               asp-action="Import"
               class="btn btn-primary">

                <i class="bi bi-cloud-arrow-down me-2"></i>

                Import New Leads

            </a>

        </div>

    </div>


    <!-- =========================================
         Search and Filters
    ========================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-controller="Lead"
                  asp-action="ApiLeads"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-lg-5">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@Model.Search"
                                   class="form-control"
                                   placeholder="Lead name, company, email, phone or code..." />

                        </div>

                    </div>


                    <!-- Source -->
                    <div class="col-lg-2">

                        <label class="form-label fw-semibold">
                            Source
                        </label>

                        <select name="source"
                                class="form-select">

                            <option value="">
                                All Sources
                            </option>

                            @foreach (var item in Enum.GetValues<CRMSystem.Enums.LeadSource>())
                            {
                                <option value="@item"
                                        selected="@(Model.Source == item ? "selected" : null)">
                                    @item
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Status -->
                    <div class="col-lg-2">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            @foreach (var item in Enum.GetValues<CRMSystem.Enums.LeadStatus>())
                            {
                                <option value="@item"
                                        selected="@(Model.Status == item ? "selected" : null)">
                                    @item
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Search Button -->
                    <div class="col-lg-1">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search"></i>

                        </button>

                    </div>


                    <!-- Clear -->
                    <div class="col-lg-2">

                        <a asp-controller="Lead"
                           asp-action="ApiLeads"
                           class="btn btn-outline-secondary w-100">

                            <i class="bi bi-x-circle me-1"></i>

                            Clear

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total API Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="text-muted mb-1">
                                Total API Leads
                            </h6>

                            <h2 class="fw-bold mb-0">
                                @Model.Leads.Count
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-primary">

                            <i class="bi bi-cloud-arrow-down"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- New Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="text-muted mb-1">
                                New Leads
                            </h6>

                            <h2 class="fw-bold mb-0">
                                @Model.Leads.Count(x =>
                                    x.Status == CRMSystem.Enums.LeadStatus.New)
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-warning">

                            <i class="bi bi-person-plus-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Assigned Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="text-muted mb-1">
                                Assigned Leads
                            </h6>

                            <h2 class="fw-bold mb-0">
                                @Model.Leads.Count(x =>
                                    x.Status == CRMSystem.Enums.LeadStatus.Assigned ||
                                    x.Status == CRMSystem.Enums.LeadStatus.Accepted ||
                                    x.Status == CRMSystem.Enums.LeadStatus.InProgress)
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-success">

                            <i class="bi bi-person-check-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Completed Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="text-muted mb-1">
                                Completed
                            </h6>

                            <h2 class="fw-bold mb-0">
                                @Model.Leads.Count(x =>
                                    x.Status == CRMSystem.Enums.LeadStatus.Completed)
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-info">

                            <i class="bi bi-check-circle-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- API Leads Table -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-1 fw-semibold">
                        API Captured Leads
                    </h5>

                    <small class="text-muted">
                        Leads automatically captured from external sources.
                    </small>

                </div>

                <span class="badge bg-primary">
                    @Model.Leads.Count
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                #
                            </th>

                            <th>
                                Lead
                            </th>

                            <th>
                                Company
                            </th>

                            <th>
                                Contact
                            </th>

                            <th>
                                Source
                            </th>

                            <th>
                                Priority
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Assigned To
                            </th>

                            <th>
                                Created
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>
                        @if (Model.Leads.Any())
                        {
                            var index = 1;

                            foreach (var lead in Model.Leads)
                            {
                                <tr>

                                    <!-- Serial -->
                                    <td class="ps-4">
                                        @index
                                    </td>


                                    <!-- Lead -->
                                    <td>

                                        <div class="fw-semibold">
                                            @lead.LeadName
                                        </div>

                                        <small class="text-muted">
                                            @lead.LeadCode
                                        </small>

                                    </td>


                                    <!-- Company -->
                                    <td>

                                        @(string.IsNullOrWhiteSpace(lead.CompanyName)
                                            ? "-"
                                            : lead.CompanyName)

                                    </td>


                                    <!-- Contact -->
                                    <td>

                                        <div>
                                            <i class="bi bi-telephone me-1"></i>
                                            @lead.Phone
                                        </div>

                                        <div class="small text-muted">

                                            <i class="bi bi-envelope me-1"></i>

                                            @(string.IsNullOrWhiteSpace(lead.Email)
                                                ? "-"
                                                : lead.Email)

                                        </div>

                                    </td>


                                    <!-- Source -->
                                    <td>

                                        <span class="badge bg-primary">

                                            @lead.Source

                                        </span>

                                    </td>


                                    <!-- Priority -->
                                    <td>

                                        @if (lead.Priority ==
                                            CRMSystem.Enums.LeadPriority.High)
                                        {
                                            <span class="badge bg-danger">
                                                High
                                            </span>
                                        }
                                        else if (lead.Priority ==
                                            CRMSystem.Enums.LeadPriority.Medium)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Medium
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Low
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (lead.Status ==
                                            CRMSystem.Enums.LeadStatus.New)
                                        {
                                            <span class="badge bg-primary">
                                                New
                                            </span>
                                        }
                                        else if (lead.Status ==
                                            CRMSystem.Enums.LeadStatus.Assigned)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Assigned
                                            </span>
                                        }
                                        else if (lead.Status ==
                                            CRMSystem.Enums.LeadStatus.Accepted)
                                        {
                                            <span class="badge bg-info">
                                                Accepted
                                            </span>
                                        }
                                        else if (lead.Status ==
                                            CRMSystem.Enums.LeadStatus.InProgress)
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else if (lead.Status ==
                                            CRMSystem.Enums.LeadStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }

                                    </td>


                                    <!-- Assigned To -->
                                    <td>

                                        @if (string.IsNullOrWhiteSpace(lead.AssignedTo))
                                        {
                                            <span class="text-muted">
                                                Unassigned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">
                                                @lead.AssignedTo
                                            </span>
                                        }

                                    </td>


                                    <!-- Created -->
                                    <td>

                                        <div>
                                            @lead.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @lead.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                        </small>

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-controller="Lead"
                                               asp-action="Details"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View Lead">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <a asp-controller="Lead"
                                               asp-action="Edit"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Edit Lead">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <a asp-controller="Lead"
                                               asp-action="Assign"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-sm btn-outline-success"
                                               title="Assign Lead">

                                                <i class="bi bi-person-check"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                index++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="10"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-cloud-slash fs-1 d-block mb-3"></i>

                                        <h5>
                                            No API Leads Found
                                        </h5>

                                        <p class="mb-3">
                                            No leads have been captured from API sources yet.
                                        </p>

                                        <a asp-controller="GoogleForms"
                                           asp-action="Import"
                                           class="btn btn-primary">

                                            <i class="bi bi-cloud-arrow-down me-2"></i>

                                            Import New Leads

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>