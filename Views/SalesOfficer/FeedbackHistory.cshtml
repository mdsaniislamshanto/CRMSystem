@model List<CRMSystem.Models.ViewModels.FeedbackHistoryViewModel>

@{
    Layout = "~/Views/Shared/_SalesOfficerLayout.cshtml";

    ViewData["Title"] = "Feedback History";
    ViewData["Breadcrumb"] = "Feedback History";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white d-flex align-items-center">

        <i class="bi bi-clock-history fs-4 me-3"></i>

        <div>

            <h4 class="mb-0">

                Feedback History

            </h4>

            <small>

                View your previously submitted lead feedback.

            </small>

        </div>

    </div>

    <div class="card-body p-4">

        @if (!Model.Any())
        {
            <div class="alert alert-info">

                <i class="bi bi-info-circle me-2"></i>

                No feedback history available.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light text-center">

                        <tr>

                            <th>Lead ID</th>

                            <th>Company</th>

                            <th>Lead Name</th>

                            <th>Feedback Status</th>

                            <th>Submitted At</th>

                            <th>Next Follow-up</th>

                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var feedback in Model)
                        {
                            <tr>

                                <td class="text-center">

                                    @feedback.LeadId

                                </td>

                                <td>

                                    @feedback.CompanyName

                                </td>

                                <td>

                                    @feedback.LeadName

                                </td>

                                <td class="text-center">

                                    @switch (feedback.Status)
                                    {
                                        case CRMSystem.Enums.FeedbackStatus.Interested:

                                            <span class="badge rounded-pill bg-primary px-3 py-2">

                                                Interested

                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.FollowUpRequired:

                                            <span class="badge rounded-pill bg-warning text-dark px-3 py-2">

                                                Follow-up Required

                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.MeetingScheduled:

                                            <span class="badge rounded-pill bg-info text-dark px-3 py-2">

                                                Meeting Scheduled

                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.Visited:

                                            <span class="badge rounded-pill bg-secondary px-3 py-2">

                                                Visited

                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.QuotationSent:

                                            <span class="badge rounded-pill bg-dark px-3 py-2">

                                                Quotation Sent

                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.Negotiation:

                                            <span class="badge rounded-pill bg-warning text-dark px-3 py-2">

                                                Negotiation

                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.Completed:

                                            <span class="badge rounded-pill bg-success px-3 py-2">

                                                Completed

                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.Closed:

                                            <span class="badge rounded-pill bg-danger px-3 py-2">

                                                Closed

                                            </span>

                                            break;

                                        default:

                                            <span class="badge rounded-pill bg-secondary px-3 py-2">

                                                @feedback.Status

                                            </span>

                                            break;
                                    }

                                </td>

                                <td class="text-center text-nowrap">

                                    @feedback.SubmittedAt.ToString(
                                        "dd MMM yyyy hh:mm tt")

                                </td>

                                <td class="text-center text-nowrap">

                                    @if (feedback.NextFollowUpDate.HasValue)
                                    {
                                        @feedback.NextFollowUpDate.Value.ToString(
                                            "dd MMM yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            -

                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-controller="SalesOfficer"
                                       asp-action="FeedbackDetails"
                                       asp-route-feedbackId="@feedback.FeedbackId"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-eye me-1"></i>

                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>