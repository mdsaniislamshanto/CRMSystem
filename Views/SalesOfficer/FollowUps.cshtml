@model List<CRMSystem.Models.ViewModels.SalesOfficerFollowUpViewModel>

@{
    Layout = "~/Views/Shared/_SalesOfficerLayout.cshtml";

    ViewData["Title"] = "Follow-ups";
    ViewData["Breadcrumb"] = "Follow-ups";
}

<div class="card shadow">

    <!-- Header -->

    <div class="card-header bg-primary text-white d-flex align-items-center">

        <i class="bi bi-calendar-check-fill fs-4 me-3"></i>

        <div>

            <h4 class="mb-0">
                Follow-ups
            </h4>

            <small>
                Manage your upcoming customer follow-ups and submit feedback.
            </small>

        </div>

    </div>


    <!-- Body -->

    <div class="card-body p-4">

        @if (!Model.Any())
        {
            <div class="alert alert-info d-flex align-items-center">

                <i class="bi bi-info-circle-fill me-2"></i>

                <div>
                    No upcoming follow-ups found.
                </div>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Lead ID
                            </th>

                            <th>
                                Company
                            </th>

                            <th>
                                Lead Name
                            </th>

                            <th>
                                Current Status
                            </th>

                            <th>
                                Follow-up Date
                            </th>

                            <th>
                                Last Feedback
                            </th>

                            <th style="min-width: 155px;">
                                <i class="bi bi-robot me-1 text-primary"></i> AI Analysis
                            </th>

                            <th class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var followUp in Model)
                        {
                            <tr>

                                <td>
                                    <span class="fw-semibold">
                                        #@followUp.LeadId
                                    </span>
                                </td>


                                <td>
                                    @followUp.CompanyName
                                </td>


                                <td>
                                    @followUp.LeadName
                                </td>


                                <td>

                                    @switch (followUp.Status)
                                    {
                                        case CRMSystem.Enums.FeedbackStatus.Interested:

                                            <span class="badge rounded-pill bg-primary">
                                                Interested
                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.FollowUpRequired:

                                            <span class="badge rounded-pill bg-warning text-dark">
                                                Follow-up Required
                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.MeetingScheduled:

                                            <span class="badge rounded-pill bg-info text-dark">
                                                Meeting Scheduled
                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.Visited:

                                            <span class="badge rounded-pill bg-secondary">
                                                Visited
                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.QuotationSent:

                                            <span class="badge rounded-pill bg-dark">
                                                Quotation Sent
                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.Negotiation:

                                            <span class="badge rounded-pill bg-warning text-dark">
                                                Negotiation
                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.Completed:

                                            <span class="badge rounded-pill bg-success">
                                                Completed
                                            </span>

                                            break;

                                        case CRMSystem.Enums.FeedbackStatus.Closed:

                                            <span class="badge rounded-pill bg-danger">
                                                Closed
                                            </span>

                                            break;

                                        default:

                                            <span class="badge rounded-pill bg-secondary">
                                                @followUp.Status
                                            </span>

                                            break;
                                    }

                                </td>


                                <td>

                                    <div class="fw-semibold">

                                        @followUp.NextFollowUpDate.ToBangladeshTime().ToString("dd MMM yyyy")

                                    </div>

                                </td>


                                <td>

                                    <div>
                                        @followUp.SubmittedAt.ToBangladeshTime().ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted">
                                        @followUp.SubmittedAt.ToBangladeshTime().ToString("hh:mm tt")
                                    </small>

                                </td>


                                <!-- AI Analysis -->
                                <td id="ai-cell-@followUp.FeedbackId">
                                    @if (followUp.AiAnalyzed)
                                    {
                                        <div class="d-flex flex-column gap-1 align-items-start">
                                            <div class="d-flex flex-wrap gap-1">
                                                @if (followUp.AiCustomerInterested == true)
                                                {
                                                    <span class="badge bg-success" title="Customer Interested">
                                                        <i class="bi bi-check-circle me-1"></i>Interested
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger" title="Not Interested">
                                                        <i class="bi bi-x-circle me-1"></i>Not Interested
                                                    </span>
                                                }

                                                @if (followUp.AiBuyingIntent == "High")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success" title="Purchase Likelihood: High">
                                                        High Buy
                                                    </span>
                                                }
                                                else if (followUp.AiBuyingIntent == "Low")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger" title="Purchase Likelihood: Low">
                                                        Low Buy
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-dark border border-warning" title="Purchase Likelihood: Moderate">
                                                        Moderate
                                                    </span>
                                                }

                                                @if (followUp.AiSiteVisitInterested == true)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary" title="Interested in Site Visit">
                                                        <i class="bi bi-geo-alt me-1"></i>Site Visit
                                                    </span>
                                                }
                                            </div>

                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 mt-1" style="font-size: 0.75rem;" onclick="openAiAnalysisModal(@followUp.FeedbackId)">
                                                <i class="bi bi-sparkles me-1"></i> AI Details
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.78rem;" onclick="analyzeFromTable(@followUp.FeedbackId, this)">
                                            <i class="bi bi-stars text-primary me-1"></i> Analyze with AI
                                        </button>
                                    }
                                </td>


                                <td class="text-center">

                                    <a asp-action="SubmitFeedback"
                                       asp-route-assignmentId="@followUp.AssignmentId"
                                       class="btn btn-primary btn-sm">

                                        <i class="bi bi-chat-left-text-fill me-1"></i>

                                        Submit Feedback

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<partial name="_AiAnalysisModalPartial" />