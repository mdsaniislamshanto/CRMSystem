@model CRMSystem.Models.ViewModels.TeamLeadMyTeamViewModel

@{
    ViewData["Title"] = "Sales Officers";
    ViewData["Breadcrumb"] = "Sales Officers";
    Layout = "_TeamLeadLayout";
}


<div class="container-fluid">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Sales Officers
            </h2>

            <p class="text-muted mb-0">
                View and monitor the Sales Officers assigned
                to your team.
            </p>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY CARDS
         ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Team Members -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-muted small">
                                Team Members
                            </div>

                            <div class="fs-2 fw-bold">
                                @Model.TeamMemberCount
                            </div>

                        </div>

                        <div class="rounded-circle
                            bg-primary-subtle
                            text-primary
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:52px;height:52px;">

                            <i class="bi bi-people fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Active Officers -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-muted small">
                                Active Officers
                            </div>

                            <div class="fs-2 fw-bold">

                                @Model.TeamMembers.Count(
                                    x => x.IsActive)

                            </div>

                        </div>

                        <div class="rounded-circle
                            bg-success-subtle
                            text-success
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:52px;height:52px;">

                            <i class="bi bi-person-check fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Leads -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-muted small">
                                Total Team Leads
                            </div>

                            <div class="fs-2 fw-bold">

                                @Model.TeamMembers.Sum(
                                    x => x.TotalLeads)

                            </div>

                        </div>

                        <div class="rounded-circle
                            bg-warning-subtle
                            text-warning
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:52px;height:52px;">

                            <i class="bi bi-bar-chart-line fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SALES OFFICERS TABLE
         ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white
            d-flex
            justify-content-between
            align-items-center">

            <div>

                <h5 class="mb-1 fw-semibold">
                    Sales Officers
                </h5>

                <small class="text-muted">
                    Sales Officers assigned to
                    @Model.TeamLeadName
                </small>

            </div>


            <span class="badge bg-primary">
                @Model.TeamMemberCount
                Officer@(Model.TeamMemberCount == 1 ? "" : "s")
            </span>

        </div>


        <div class="card-body p-0">

            @if (Model.TeamMembers == null ||
                 !Model.TeamMembers.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-people fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No Sales Officers Found
                    </h5>

                    <p class="text-muted mb-0">
                        No Sales Officers are currently
                        assigned to your team.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                        table-hover
                        align-middle
                        mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Employee
                                </th>

                                <th>
                                    Contact
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-center">
                                    Total Leads
                                </th>

                                <th class="text-center">
                                    Active Leads
                                </th>

                                <th class="text-center">
                                    Completed
                                </th>

                                <th class="text-center">
                                    Follow-ups
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var officer
                                in Model.TeamMembers)
                            {
                                <tr>

                                    <!-- Employee -->

                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @officer.FullName
                                        </div>

                                        <small class="text-muted">
                                            @officer.EmployeeCode
                                        </small>

                                    </td>


                                    <!-- Contact -->

                                    <td>

                                        <div>
                                            @officer.Email
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            officer.PhoneNumber))
                                        {
                                            <small class="text-muted">
                                                @officer.PhoneNumber
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">
                                                No phone number
                                            </small>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (officer.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <!-- Total Leads -->

                                    <td class="text-center">

                                        <span class="fw-semibold">
                                            @officer.TotalLeads
                                        </span>

                                    </td>


                                    <!-- Active Leads -->

                                    <td class="text-center">

                                        <span class="badge bg-primary">
                                            @officer.ActiveLeads
                                        </span>

                                    </td>


                                    <!-- Completed -->

                                    <td class="text-center">

                                        <span class="badge bg-success">
                                            @officer.CompletedLeads
                                        </span>

                                    </td>


                                    <!-- Follow-ups -->

                                    <td class="text-center">

                                        <span class="badge bg-warning text-dark">
                                            @officer.PendingFollowUps
                                        </span>

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-center">

                                        <a asp-controller="TeamLead"
                                           asp-action="OfficerDetails"
                                           asp-route-id="@officer.UserId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Officer Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<style>

    .card {
        border-radius: 10px;
    }

    .table th {
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .table td {
        font-size: 14px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

</style>