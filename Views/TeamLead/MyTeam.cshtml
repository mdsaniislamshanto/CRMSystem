@model CRMSystem.Models.ViewModels.TeamLeadMyTeamViewModel

@{
    ViewData["Title"] = "My Team";
    Layout = "_TeamLeadLayout";
}


<div class="container-fluid">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            My Team
        </h2>

        <p class="text-muted mb-0">
            View and monitor your assigned Sales Officers.
        </p>

    </div>


    <!-- =====================================================
         SUMMARY CARD
         ===================================================== -->

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Team Lead
                            </p>

                            <h5 class="fw-bold mb-0">
                                @Model.TeamLeadName
                            </h5>

                        </div>

                        <div class="rounded-circle
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="
                            width: 48px;
                            height: 48px;
                            background: #eef2ff;
                            color: #2563eb;
                            ">

                            <i class="bi bi-person-badge fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Team Members
                            </p>

                            <h3 class="fw-bold mb-0">
                                @Model.TeamMemberCount
                            </h3>

                        </div>

                        <div class="rounded-circle
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="
                            width: 48px;
                            height: 48px;
                            background: #ecfdf5;
                            color: #059669;
                            ">

                            <i class="bi bi-people fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TEAM MEMBERS
         ===================================================== -->

    <div class="card border-0 shadow-sm">


        <div class="card-header bg-white py-3">

            <div class="d-flex
                justify-content-between
                align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Sales Officers
                    </h5>

                    <p class="text-muted mb-0 small">
                        Sales Officers assigned to your team.
                    </p>

                </div>

            </div>

        </div>


        <div class="card-body p-0">


            @if (Model.TeamMembers != null &&
                 Model.TeamMembers.Any())
            {
                <div class="table-responsive">

                    <table class="table
                        table-hover
                        align-middle
                        mb-0">


                        <thead class="table-light">

                            <tr>

                                <th class="px-4">
                                    Employee
                                </th>

                                <th>
                                    Contact
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-center">
                                    Total Leads
                                </th>

                                <th class="text-center">
                                    Active Leads
                                </th>

                                <th class="text-center">
                                    Completed
                                </th>

                                <th class="text-center">
                                    Follow-ups
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var member in Model.TeamMembers)
                            {
                                <tr>

                                    <!-- Employee -->

                                    <td class="px-4">

                                        <div class="fw-semibold">
                                            @member.FullName
                                        </div>

                                        <div class="text-muted small">
                                            @member.EmployeeCode
                                        </div>

                                    </td>


                                    <!-- Contact -->

                                    <td>

                                        <div>
                                            @member.Email
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            member.PhoneNumber))
                                        {
                                            <div class="text-muted small">
                                                @member.PhoneNumber
                                            </div>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (member.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <!-- Total Leads -->

                                    <td class="text-center">

                                        <span class="fw-semibold">
                                            @member.TotalLeads
                                        </span>

                                    </td>


                                    <!-- Active Leads -->

                                    <td class="text-center">

                                        <span class="badge bg-primary">
                                            @member.ActiveLeads
                                        </span>

                                    </td>


                                    <!-- Completed Leads -->

                                    <td class="text-center">

                                        <span class="badge bg-success">
                                            @member.CompletedLeads
                                        </span>

                                    </td>


                                    <!-- Follow-ups -->

                                    <td class="text-center">

                                        <span class="badge bg-warning text-dark">
                                            @member.PendingFollowUps
                                        </span>

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-center">

                                        <a asp-action="OfficerDetails"
                                           asp-route-id="@member.UserId"
                                           class="btn btn-sm btn-info text-white"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-people fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No Team Members Found
                    </h5>

                    <p class="text-muted mb-0">
                        No active Sales Officers are currently
                        assigned to your team.
                    </p>

                </div>
            }


        </div>

    </div>


</div>