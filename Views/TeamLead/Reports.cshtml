@model CRMSystem.Models.ViewModels.TeamLeadReportViewModel

@{
    ViewData["Title"] = "Team Lead Reports";
   
    ViewData["Breadcrumb"] = "Reports";
    Layout = "_TeamLeadLayout";

}

<div class="container-fluid px-0">

    <!-- ===================================================== -->
    <!-- Page Header -->
    <!-- ===================================================== -->

    <div class="d-flex flex-column flex-lg-row
        justify-content-between
        align-items-lg-center
        gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Team Lead Reports
            </h2>

            <p class="text-muted mb-0">
                Performance overview for
                <strong>@Model.TeamLeadName</strong>
            </p>
        </div>

        <div class="text-muted small">
            <i class="bi bi-calendar3 me-1"></i>
            @Model.FromDate.ToString("dd MMM yyyy")
            -
            @Model.ToDate.ToString("dd MMM yyyy")
        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Report Filters -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <!-- ================================================= -->
            <!-- Quick Date Filters -->
            <!-- ================================================= -->

            <div class="d-flex flex-wrap gap-2 mb-3">

                <a asp-controller="TeamLead"
                   asp-action="Reports"
                   asp-route-range="today"
                   class="btn btn-outline-primary">

                    <i class="bi bi-calendar-day me-1"></i>
                    Today

                </a>


                <a asp-controller="TeamLead"
                   asp-action="Reports"
                   asp-route-range="week"
                   class="btn btn-outline-primary">

                    <i class="bi bi-calendar-week me-1"></i>
                    This Week

                </a>


                <a asp-controller="TeamLead"
                   asp-action="Reports"
                   asp-route-range="month"
                   class="btn btn-outline-primary">

                    <i class="bi bi-calendar-month me-1"></i>
                    This Month

                </a>

            </div>


            <!-- ================================================= -->
            <!-- Custom Date Range -->
            <!-- ================================================= -->

            <form asp-controller="TeamLead"
                  asp-action="Reports"
                  method="get">

                <input type="hidden"
                       name="range"
                       value="custom" />


                <div class="row g-3 align-items-end">

                    <!-- From Date -->

                    <div class="col-md-4">

                        <label for="fromDate"
                               class="form-label fw-semibold">

                            From Date

                        </label>

                        <input type="date"
                               id="fromDate"
                               name="fromDate"
                               class="form-control"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")" />

                    </div>


                    <!-- To Date -->

                    <div class="col-md-4">

                        <label for="toDate"
                               class="form-label fw-semibold">

                            To Date

                        </label>

                        <input type="date"
                               id="toDate"
                               name="toDate"
                               class="form-control"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")" />

                    </div>


                    <!-- Generate -->

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-bar-chart-line me-1"></i>

                            Generate Report

                        </button>

                    </div>

                </div>

            </form>


            <!-- ================================================= -->
            <!-- Download Buttons -->
            <!-- ================================================= -->

            <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">

                <a asp-controller="TeamLead"
                   asp-action="DownloadReportPdf"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
                   class="btn btn-danger">

                    <i class="bi bi-file-earmark-pdf me-1"></i>

                    Download PDF

                </a>


                <a asp-controller="TeamLead"
                   asp-action="DownloadReportExcel"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
                   class="btn btn-success">

                    <i class="bi bi-file-earmark-excel me-1"></i>

                    Download Excel

                </a>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- Summary Cards -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Sales Officers -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-muted small">
                                Sales Officers
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalSalesOfficers
                            </h3>

                        </div>

                        <div class="fs-2 text-primary">
                            <i class="bi bi-people"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Assigned Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-muted small">
                                Assigned Leads
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalAssignedLeads
                            </h3>

                        </div>

                        <div class="fs-2 text-info">
                            <i class="bi bi-diagram-3"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Accepted Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-muted small">
                                Accepted Leads
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalAcceptedLeads
                            </h3>

                        </div>

                        <div class="fs-2 text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Completed Leads -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-muted small">
                                Completed Leads
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalCompletedLeads
                            </h3>

                        </div>

                        <div class="fs-2 text-success">
                            <i class="bi bi-trophy"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Follow-up Summary -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Feedbacks
                    </div>

                    <h3 class="fw-bold mb-0">
                        @Model.TotalFeedbacks
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Pending Follow-ups
                    </div>

                    <h3 class="fw-bold mb-0">
                        @Model.TotalPendingFollowUps
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Overdue Follow-ups
                    </div>

                    <h3 class="fw-bold mb-0">
                        @Model.TotalOverdueFollowUps
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Team Target
                    </div>

                    <h3 class="fw-bold mb-0">
                        @Model.TeamTarget
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- KPI Performance -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Performance Score -->

        <div class="col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="text-muted small mb-2">
                        Overall Performance Score
                    </div>

                    <div class="display-4 fw-bold text-primary">
                        @Model.PerformanceScore.ToString("0.00")%
                    </div>

                    <div class="text-muted small mt-2">
                        Weighted Team Performance
                    </div>

                </div>

            </div>

        </div>


        <!-- Target Achievement -->

        <div class="col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        mb-2">

                        <span class="fw-semibold">
                            Target Achievement
                        </span>

                        <span class="fw-bold">
                            @Model.TargetAchievementPercentage.ToString("0.00")%
                        </span>

                    </div>

                    <div class="progress"
                         style="height: 10px;">

                        <div class="progress-bar"
                             role="progressbar"
                             style="width: @Math.Min(Model.TargetAchievementPercentage, 100)%;">
                        </div>

                    </div>

                    <div class="small text-muted mt-2">
                        @Model.TargetCompletedLeads /
                        @Model.TeamTarget completed
                    </div>

                </div>

            </div>

        </div>


        <!-- Completion -->

        <div class="col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        mb-2">

                        <span class="fw-semibold">
                            Completion Rate
                        </span>

                        <span class="fw-bold">
                            @Model.CompletionRate.ToString("0.00")%
                        </span>

                    </div>

                    <div class="progress"
                         style="height: 10px;">

                        <div class="progress-bar"
                             role="progressbar"
                             style="width: @Math.Min(Model.CompletionRate, 100)%;">
                        </div>

                    </div>

                    <div class="small text-muted mt-2">
                        Completed:
                        @Model.TotalCompletedLeads
                        /
                        @Model.TotalAssignedLeads
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- KPI Details -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-speedometer2 me-2"></i>
                KPI Performance
            </h5>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- Acceptance Rate -->

                <div class="col-lg-4 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex
                            justify-content-between">

                            <span class="text-muted">
                                Acceptance Rate
                            </span>

                            <strong>
                                @Model.AcceptanceRate.ToString("0.00")%
                            </strong>

                        </div>

                        <div class="progress mt-2"
                             style="height: 7px;">

                            <div class="progress-bar"
                                 style="width: @Math.Min(Model.AcceptanceRate, 100)%;">
                            </div>

                        </div>

                        <small class="text-muted">
                            Weight: 10%
                        </small>

                    </div>

                </div>


                <!-- Acceptance SLA -->

                <div class="col-lg-4 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex
                            justify-content-between">

                            <span class="text-muted">
                                Acceptance SLA
                            </span>

                            <strong>
                                @Model.AcceptanceSLAComplianceRate.ToString("0.00")%
                            </strong>

                        </div>

                        <div class="progress mt-2"
                             style="height: 7px;">

                            <div class="progress-bar"
                                 style="width: @Math.Min(Model.AcceptanceSLAComplianceRate, 100)%;">
                            </div>

                        </div>

                        <small class="text-muted">
                            Weight: 15%
                        </small>

                    </div>

                </div>


                <!-- First Feedback SLA -->

                <div class="col-lg-4 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex
                            justify-content-between">

                            <span class="text-muted">
                                First Feedback SLA
                            </span>

                            <strong>
                                @Model.FirstFeedbackSLAComplianceRate.ToString("0.00")%
                            </strong>

                        </div>

                        <div class="progress mt-2"
                             style="height: 7px;">

                            <div class="progress-bar"
                                 style="width: @Math.Min(Model.FirstFeedbackSLAComplianceRate, 100)%;">
                            </div>

                        </div>

                        <small class="text-muted">
                            Weight: 20%
                        </small>

                    </div>

                </div>


                <!-- Follow-up Timeliness -->

                <div class="col-lg-4 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex
                            justify-content-between">

                            <span class="text-muted">
                                Follow-up Timeliness
                            </span>

                            <strong>
                                @Model.FollowUpTimelinessRate.ToString("0.00")%
                            </strong>

                        </div>

                        <div class="progress mt-2"
                             style="height: 7px;">

                            <div class="progress-bar"
                                 style="width: @Math.Min(Model.FollowUpTimelinessRate, 100)%;">
                            </div>

                        </div>

                        <small class="text-muted">
                            Weight: 20%
                        </small>

                    </div>

                </div>


                <!-- Next Feedback SLA -->

                <div class="col-lg-4 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex
                            justify-content-between">

                            <span class="text-muted">
                                Next Feedback SLA
                            </span>

                            <strong>
                                @Model.NextFeedbackSLAComplianceRate.ToString("0.00")%
                            </strong>

                        </div>

                        <div class="progress mt-2"
                             style="height: 7px;">

                            <div class="progress-bar"
                                 style="width: @Math.Min(Model.NextFeedbackSLAComplianceRate, 100)%;">
                            </div>

                        </div>

                        <small class="text-muted">
                            Weight: 10%
                        </small>

                    </div>

                </div>


                <!-- Completion Rate -->

                <div class="col-lg-4 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex
                            justify-content-between">

                            <span class="text-muted">
                                Completion Rate
                            </span>

                            <strong>
                                @Model.CompletionRate.ToString("0.00")%
                            </strong>

                        </div>

                        <div class="progress mt-2"
                             style="height: 7px;">

                            <div class="progress-bar"
                                 style="width: @Math.Min(Model.CompletionRate, 100)%;">
                            </div>

                        </div>

                        <small class="text-muted">
                            Weight: 25%
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Officer Performance -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex
                justify-content-between
                align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-person-lines-fill me-2"></i>
                        Sales Officer Performance
                    </h5>

                    <small class="text-muted">
                        Team member performance ranking
                    </small>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.OfficerReports != null &&
                 Model.OfficerReports.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover
                        align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-3">
                                    #
                                </th>

                                <th>
                                    Sales Officer
                                </th>

                                <th>
                                    Assigned
                                </th>

                                <th>
                                    Accepted
                                </th>

                                <th>
                                    Acceptance Rate
                                </th>

                                <th>
                                    Completed
                                </th>

                                <th>
                                    Completion
                                </th>

                                <th>
                                    First Feedback
                                </th>

                                <th>
                                    Follow-up
                                </th>

                                <th>
                                    Acceptance SLA
                                </th>

                                <th>
                                    Next Feedback SLA
                                </th>

                                <th>
                                    Score
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var rank = 1;
                            }

                            @foreach (var officer in Model.OfficerReports)
                            {
                                <tr>

                                    <td class="px-3 fw-semibold">
                                        @rank
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @officer.SalesOfficerName
                                        </div>
                                    </td>

                                    <td>
                                        @officer.TotalAssignedLeads
                                    </td>

                                    <td>
                                        @officer.AcceptedLeads
                                    </td>

                                    <td>
                                        @officer.AcceptanceRate.ToString("0.00")%
                                    </td>

                                    <td>
                                        @officer.CompletedLeads
                                    </td>

                                    <td>
                                        @officer.CompletionRate.ToString("0.00")%
                                    </td>

                                    <td>
                                        @officer.FirstFeedbackSLAComplianceRate.ToString("0.00")%
                                    </td>

                                    <td>
                                        @officer.FollowUpTimelinessRate.ToString("0.00")%
                                    </td>

                                    <td>
                                        @officer.AcceptanceSLAComplianceRate.ToString("0.00")%
                                    </td>

                                    <td>
                                        @officer.NextFeedbackSLAComplianceRate.ToString("0.00")%
                                    </td>

                                    <td>

                                        <span class="badge
                                            @(officer.PerformanceScore >= 80
                                                ? "bg-success"
                                                : officer.PerformanceScore >= 60
                                                    ? "bg-warning text-dark"
                                                    : "bg-danger")">

                                            @officer.PerformanceScore.ToString("0.00")%

                                        </span>

                                    </td>

                                </tr>

                                rank++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center
                    text-muted
                    py-5">

                    <i class="bi bi-people fs-1 d-block mb-3"></i>

                    <h6 class="fw-semibold">
                        No Sales Officer Data
                    </h6>

                    <p class="mb-0">
                        No team performance data is available
                        for the selected period.
                    </p>

                </div>
            }

        </div>

    </div>

</div>