@model CRMSystem.Models.ViewModels.TeamLeadDashboardViewModel

@{
    ViewData["Title"] = "Team Lead Dashboard";
    Layout = "_TeamLeadLayout";
}

<div class="container-fluid">

    <!-- ===================================================== -->
    <!-- Page Header -->
    <!-- ===================================================== -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Team Lead Dashboard
        </h2>

        <p class="text-muted mb-0">
            Welcome, @Model.TeamLeadName
        </p>

    </div>


    <!-- ===================================================== -->
    <!-- Dashboard KPI Cards -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- My Team -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                My Team
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TeamMemberCount
                            </h2>

                            <small class="text-muted">
                                Sales Officers
                            </small>

                        </div>

                        <div class="fs-1 text-primary">
                            <i class="bi bi-people"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Active Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Active Leads
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.ActiveLeadCount
                            </h2>

                            <small class="text-muted">
                                Currently in progress
                            </small>

                        </div>

                        <div class="fs-1 text-success">
                            <i class="bi bi-person-lines-fill"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Pending Follow-ups -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Pending Follow-ups
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.PendingFollowUpCount
                            </h2>

                            <small class="text-muted">
                                Today and upcoming
                            </small>

                        </div>

                        <div class="fs-1 text-warning">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Completed Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Completed Leads
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.CompletedLeadCount
                            </h2>

                            <small class="text-muted">
                                Successfully completed
                            </small>

                        </div>

                        <div class="fs-1 text-info">
                            <i class="bi bi-check2-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Target Overview -->
    <!-- ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white border-bottom d-flex align-items-center py-3">

            <i class="bi bi-bullseye me-2 text-primary"></i>

            <strong>
                Target Overview
            </strong>

        </div>


        <div class="card-body py-4">

            <div class="row align-items-center">

                <!-- Total Target -->
                <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <div class="rounded-circle bg-primary bg-opacity-10
                                d-flex align-items-center justify-content-center"
                                 style="width: 52px; height: 52px;">

                                <i class="bi bi-bullseye text-primary fs-4"></i>

                            </div>

                        </div>


                        <div>

                            <div class="text-muted small">
                                Total Target
                            </div>

                            <h3 class="mb-0 fw-semibold">
                                @Model.TotalTarget
                            </h3>

                        </div>

                    </div>

                </div>


                <!-- Target Fulfilled -->
                <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <div class="rounded-circle bg-success bg-opacity-10
                                d-flex align-items-center justify-content-center"
                                 style="width: 52px; height: 52px;">

                                <i class="bi bi-check-circle text-success fs-4"></i>

                            </div>

                        </div>


                        <div>

                            <div class="text-muted small">
                                Target Fulfilled
                            </div>

                            <h3 class="mb-0 fw-semibold">
                                @Model.TargetFulfilled
                            </h3>

                        </div>

                    </div>

                </div>


                <!-- Target Progress -->
                <div class="col-lg-4 col-md-12">

                    @{
                        var targetPercentage =
                            Model.TotalTarget > 0
                                ? Math.Min(
                                    (double)Model.TargetFulfilled /
                                    Model.TotalTarget * 100,
                                    100)
                                : 0;
                    }


                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <span class="text-muted small">
                            Target Progress
                        </span>

                        <span class="fw-semibold small">
                            @targetPercentage.ToString("0")%
                        </span>

                    </div>


                    <div class="progress"
                         style="height: 8px;">

                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @targetPercentage%;"
                             aria-valuenow="@targetPercentage"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>

                    </div>


                    <small class="text-muted d-block mt-1">
                        @Model.TargetFulfilled of @Model.TotalTarget completed
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Lead Pipeline -->
    <!-- ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white fw-semibold py-3">

            <i class="bi bi-bar-chart me-2"></i>

            Lead Pipeline

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- New -->
                <div class="col-xl-3 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted small">
                                    New Leads
                                </div>

                                <div class="fs-3 fw-bold">
                                    @Model.NewLeadCount
                                </div>

                            </div>

                            <i class="bi bi-plus-circle fs-3 text-primary"></i>

                        </div>

                    </div>

                </div>


                <!-- Assigned -->
                <div class="col-xl-3 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted small">
                                    Assigned
                                </div>

                                <div class="fs-3 fw-bold">
                                    @Model.AssignedLeadCount
                                </div>

                            </div>

                            <i class="bi bi-person-check fs-3 text-warning"></i>

                        </div>

                    </div>

                </div>


                <!-- Accepted -->
                <div class="col-xl-3 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted small">
                                    Accepted
                                </div>

                                <div class="fs-3 fw-bold">
                                    @Model.AcceptedLeadCount
                                </div>

                            </div>

                            <i class="bi bi-hand-thumbs-up fs-3 text-success"></i>

                        </div>

                    </div>

                </div>


                <!-- Completed -->
                <div class="col-xl-3 col-md-6">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted small">
                                    Completed
                                </div>

                                <div class="fs-3 fw-bold">
                                    @Model.CompletedLeadCount
                                </div>

                            </div>

                            <i class="bi bi-check-circle fs-3 text-info"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


