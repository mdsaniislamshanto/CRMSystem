        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3 mb-md-0">

                    <div class="d-flex justify-content-between align-items-center">

                        <span class="text-muted">
                            Active Leads
                        </span>

                        <strong>
