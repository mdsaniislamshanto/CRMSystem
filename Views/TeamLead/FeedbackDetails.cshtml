@model CRMSystem.Models.ViewModels.FeedbackDetailsViewModel

@{
    ViewData["Title"] = "Feedback Details";
    ViewData["Breadcrumb"] = "Leads / Feedback History / Details";
    Layout = "_TeamLeadLayout";
}


<div class="container-fluid">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Feedback Details
            </h2>

            <p class="text-muted mb-0">
                View complete feedback information submitted
                by the Sales Officer.
            </p>

        </div>


        <a asp-action="FeedbackHistory"
           asp-route-id="@Model.LeadId"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Feedback History

        </a>

    </div>


    <!-- =====================================================
         LEAD INFORMATION
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white fw-semibold">

            <i class="bi bi-person-lines-fill me-2"></i>

            Lead Information

        </div>


        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4 fw-semibold">
                    Lead Name
                </div>

                <div class="col-md-8">
                    @Model.LeadName
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4 fw-semibold">
                    Company
                </div>

                <div class="col-md-8">

                    @(string.IsNullOrWhiteSpace(
                        Model.CompanyName)
                        ? "Not provided"
                        : Model.CompanyName)

                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4 fw-semibold">
                    Email
                </div>

                <div class="col-md-8">

                    @(string.IsNullOrWhiteSpace(
                        Model.Email)
                        ? "Not provided"
                        : Model.Email)

                </div>

            </div>


            <div class="row">

                <div class="col-md-4 fw-semibold">
                    Phone
                </div>

                <div class="col-md-8">

                    @(string.IsNullOrWhiteSpace(
                        Model.Phone)
                        ? "Not provided"
                        : Model.Phone)

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         FEEDBACK INFORMATION
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white fw-semibold">

            <i class="bi bi-chat-left-text me-2"></i>

            Feedback Information

        </div>


        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4 fw-semibold">
                    Feedback ID
                </div>

                <div class="col-md-8">
                    #@Model.FeedbackId
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4 fw-semibold">
                    Submitted At
                </div>

                <div class="col-md-8">

                    @Model.SubmittedAt.ToString(
                        "dd MMM yyyy hh:mm tt")

                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4 fw-semibold">
                    Status
                </div>

                <div class="col-md-8">

                    <span class="badge bg-primary">
                        @Model.Status
                    </span>

                </div>

            </div>


            <div class="row">

                <div class="col-md-4 fw-semibold">
                    Summary
                </div>

                <div class="col-md-8">

                    <div class="bg-light rounded p-3">

                        @Model.Summary

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         NEXT FOLLOW-UP
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white fw-semibold">

            <i class="bi bi-calendar-check me-2"></i>

            Next Follow-up

        </div>


        <div class="card-body">

            @if (Model.NextFollowUpDate.HasValue)
            {
                <div class="row">

                    <div class="col-md-4 fw-semibold">
                        Scheduled Date
                    </div>

                    <div class="col-md-8">

                        @Model.NextFollowUpDate.Value.ToString(
                            "dd MMM yyyy hh:mm tt")

                    </div>

                </div>
            }
            else
            {
                <span class="text-muted">
                    No next follow-up scheduled.
                </span>
            }

        </div>

    </div>


    <!-- =====================================================
         NOTES
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white fw-semibold">

            <i class="bi bi-card-text me-2"></i>

            Additional Notes

        </div>


        <div class="card-body">

            @if (string.IsNullOrWhiteSpace(Model.Notes))
            {
                <span class="text-muted">
                    No additional notes provided.
                </span>
            }
            else
            {
                <div class="bg-light rounded p-3">
                    @Model.Notes
                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         PROOF IMAGE
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white fw-semibold">

            <i class="bi bi-image me-2"></i>

            Proof Image

        </div>


        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.ProofImage))
            {
                <div class="text-center">

                    <img src="@Model.ProofImage"
                         alt="Feedback Proof"
                         class="img-fluid rounded shadow-sm"
                         style="max-height:500px;" />

                    <div class="mt-3">

                        <a href="@Model.ProofImage"
                           target="_blank"
                           class="btn btn-outline-primary">

                            <i class="bi bi-box-arrow-up-right me-1"></i>

                            Open Full Image

                        </a>

                    </div>

                </div>
            }
            else
            {
                <div class="text-center py-4">

                    <i class="bi bi-image
                    fs-1
                    text-muted"></i>

                    <p class="text-muted mb-0 mt-2">
                        No proof image was submitted.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         VOICE RECORDING
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white fw-semibold">

            <i class="bi bi-mic me-2"></i>

            Voice Recording

        </div>


        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(
                Model.VoiceRecording))
            {
                <audio controls class="w-100">

                    <source src="@Model.VoiceRecording" />

                    Your browser does not support
                    audio playback.

                </audio>
            }
            else
            {
                <div class="text-center py-4">

                    <i class="bi bi-mic-mute
                    fs-1
                    text-muted"></i>

                    <p class="text-muted mb-0 mt-2">
                        No voice recording was submitted.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         REFERENCE INFORMATION
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <small class="text-muted">
                        Assignment ID
                    </small>

                    <div class="fw-semibold">
                        #@Model.AssignmentId
                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Lead ID
                    </small>

                    <div class="fw-semibold">
                        #@Model.LeadId
                    </div>

                </div>

            </div>

        </div>

    </div>


</div>