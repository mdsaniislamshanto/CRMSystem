@using Microsoft.AspNetCore.Http

<nav class="navbar navbar-expand-lg bg-white shadow-sm px-4 py-3">

    <div class="container-fluid">

        <!-- Left Side -->
        <div class="d-flex align-items-center">

            <button class="btn btn-light me-3" id="sidebarToggle">

                <i class="bi bi-list fs-4"></i>

            </button>

            <div>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-1">

                        <li class="breadcrumb-item">

                            <a asp-controller="Admin"
                               asp-action="Index"
                               class="text-decoration-none">

                                Dashboard

                            </a>

                        </li>

                        @if (ViewData["Title"] != null && ViewData["Title"]?.ToString() != "Admin Dashboard")
                        {
                            <li class="breadcrumb-item active"
                                aria-current="page">

                                @ViewData["Title"]

                            </li>
                        }

                    </ol>

                </nav>

            </div>

        </div>

        <!-- Right Side -->
        <div class="d-flex align-items-center">

            <!-- Search -->
            <div class="me-4">

                <input type="text"
                       class="form-control"
                       placeholder="Search..." />

            </div>

            <!-- Notification Bell -->

            <div class="dropdown me-3">

                <button class="btn btn-light position-relative"
                        type="button"
                        id="notificationDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <i class="bi bi-bell fs-5"></i>

                    <span id="notificationBadge"
                          class="position-absolute
                        top-0
                        start-100
                        translate-middle
                        badge
                        rounded-pill
                        bg-danger
                        d-none">

                        0

                    </span>

                </button>


                <div class="dropdown-menu
                    dropdown-menu-end
                    shadow
                    border-0
                    notification-dropdown"
                     aria-labelledby="notificationDropdown">

                    <!-- Header -->

                    <div class="d-flex
                        justify-content-between
                        align-items-center
                        px-3
                        py-2
                        border-bottom">

                        <h6 class="mb-0 fw-semibold">

                            Notifications

                        </h6>

                        <button type="button"
                                class="btn btn-sm
                            btn-link
                            text-decoration-none
                            p-0"
                                id="notificationMarkAllBtn">

                            Mark all

                        </button>

                    </div>


                    <!-- Notification List -->

                    <div id="notificationList"
                         class="notification-list">

                        <div class="text-center py-4">

                            <div class="spinner-border
                                spinner-border-sm
                                text-primary">
                            </div>

                            <div class="small text-muted mt-2">

                                Loading notifications...

                            </div>

                        </div>

                    </div>


                    <!-- Footer -->

                    <div class="border-top text-center">

                        <a asp-controller="Notification"
                           asp-action="Index"
                           class="dropdown-item
                            text-center
                            py-2
                            fw-semibold">

                            View All Notifications

                        </a>

                    </div>

                </div>

            </div>


            <!-- Anti-Forgery Token -->

            <div id="notificationAntiForgeryToken"
                 class="d-none">

                @Html.AntiForgeryToken()

            </div>

            <!-- Profile -->
            <div class="dropdown">

                <button class="btn btn-light dropdown-toggle"
                        data-bs-toggle="dropdown">

                    <i class="bi bi-person-circle me-2"></i>

                    @Context.Session.GetString("FullName")

                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                    <li>

                        <a class="dropdown-item"
                           asp-controller="Admin"
                           asp-action="Index">

                            Dashboard

                        </a>

                    </li>

                    <li>

                        <hr class="dropdown-divider">

                    </li>

                    <li>

                        <a class="dropdown-item text-danger"
                           asp-controller="Auth"
                           asp-action="Logout">

                            Logout

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </div>

</nav>