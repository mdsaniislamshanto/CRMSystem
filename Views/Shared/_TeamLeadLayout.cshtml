@using Microsoft.AspNetCore.Http

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - CRM System
    </title>


    <!-- =====================================================
         Bootstrap
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         Bootstrap Icons
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         Site CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <style>

            /* =====================================================
                       GLOBAL
                       ===================================================== */

            body {
                margin: 0;
                padding: 0;
                background: #f5f7fb;
                font-family: Arial, sans-serif;
            }


            /* =====================================================
                       SIDEBAR
                       ===================================================== */

            .teamlead-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: 230px;
                height: 100vh;
                background: #1f2a3d;
                color: white;
                overflow-y: auto;
                z-index: 1000;
            }


            /* Brand */

            .teamlead-brand {
                height: 72px;
                display: flex;
                align-items: center;
                padding: 0 24px;
                font-size: 21px;
                font-weight: 700;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }


                .teamlead-brand i {
                    font-size: 22px;
                }


            /* Navigation */

            .teamlead-nav {
                padding: 18px 12px 25px;
            }


            /* Section Title */

            .teamlead-section-title {
                margin: 20px 12px 8px;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: #9ca8ba;
            }


            /* Navigation Links */

            .teamlead-nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                width: 100%;
                padding: 11px 14px;
                margin-bottom: 5px;
                color: #dbe2ee;
                text-decoration: none;
                border-radius: 8px;
                transition: background 0.2s ease, color 0.2s ease;
            }


                .teamlead-nav-link i {
                    width: 20px;
                    text-align: center;
                    font-size: 16px;
                }


                .teamlead-nav-link:hover {
                    background: rgba(255, 255, 255, 0.08);
                    color: #ffffff;
                }


                .teamlead-nav-link.active {
                    background: #2563eb;
                    color: #ffffff;
                }


                /* Disabled */

                .teamlead-nav-link.disabled {
                    opacity: 0.55;
                    cursor: default;
                }


                    .teamlead-nav-link.disabled:hover {
                        background: transparent;
                        color: #dbe2ee;
                    }


            /* Logout */

            .teamlead-logout {
                color: #ff6b6b !important;
            }


                .teamlead-logout:hover {
                    background: rgba(255, 107, 107, 0.10) !important;
                }


            /* =====================================================
                       MAIN AREA
                       ===================================================== */

            .teamlead-main {
                margin-left: 230px;
                min-height: 100vh;
            }


            /* =====================================================
                       TOP NAVBAR
                       ===================================================== */

            .teamlead-topbar {
                height: 72px;
                background: #ffffff;
                border-bottom: 1px solid #e5e7eb;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                position: sticky;
                top: 0;
                z-index: 900;
            }


            /* =====================================================
                       PAGE TITLE
                       ===================================================== */

            .teamlead-page-title {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 15px;
            }


                .teamlead-page-title .home {
                    color: #2563eb;
                    font-weight: 600;
                }


                .teamlead-page-title .separator {
                    color: #9ca3af;
                }


                .teamlead-page-title .current {
                    color: #64748b;
                }


            /* =====================================================
                       BUTTONS
                       ===================================================== */

            .btn {
                border-radius: 8px;
            }


            /* =====================================================
                       NOTIFICATION DROPDOWN (Admin Style)
                       ===================================================== */

            .notification-dropdown {
                width: 380px;
                min-width: 380px;
                max-width: calc(100vw - 30px);
                padding: 0;
                overflow: hidden;
                box-sizing: border-box;
                border-radius: 12px;
            }

            .notification-list {
                max-height: 420px;
                overflow-y: auto;
                overflow-x: hidden;
                width: 100%;
                box-sizing: border-box;
            }

            .notification-dropdown-item {
                width: 100%;
                padding: 14px 16px;
                border-bottom: 1px solid #E2E8F0;
                transition: background-color 0.2s ease;
                box-sizing: border-box;
                overflow: hidden;
            }

                .notification-dropdown-item:hover {
                    background-color: #F8FAFC;
                }

                .notification-dropdown-item:last-child {
                    border-bottom: none;
                }

            .notification-unread {
                background-color: #F5F8FF;
            }

            .notification-content {
                display: flex;
                align-items: flex-start;
                gap: 12px;
            }

            .notification-dropdown-icon {
                width: 36px;
                height: 36px;
                min-width: 36px;
                max-width: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: #F1F3F5;
                box-sizing: border-box;
            }

                .notification-dropdown-icon i {
                    font-size: 16px;
                }

            .notification-body {
                flex: 1;
                min-width: 0;
            }

            .notification-title-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                margin-bottom: 4px;
            }

            .notification-title {
                display: block;
                flex: 1 1 auto;
                min-width: 0;
                max-width: 100%;
                font-size: 0.875rem;
                line-height: 1.4;
                font-weight: 600;
                color: #1E293B;
                white-space: normal;
                overflow-wrap: anywhere;
                word-break: normal;
            }

            .notification-new-badge {
                flex: 0 0 auto;
                font-size: 0.7rem;
                font-weight: 600;
                padding: 4px 7px;
                border-radius: 10px;
                line-height: 1;
            }

            .notification-message {
                display: block;
                width: 100%;
                max-width: 100%;
                margin-top: 5px;
                font-size: 0.8125rem;
                line-height: 1.5;
                color: #64748B !important;
                white-space: normal;
                overflow-wrap: anywhere;
                word-break: normal;
                box-sizing: border-box;
            }

            .notification-date {
                display: block;
                width: 100%;
                margin-top: 5px;
                font-size: 0.72rem;
                line-height: 1.4;
                color: #94A3B8 !important;
            }

            .notification-read-button,
            .mark-notification-read {
                display: inline-block;
                margin-top: 4px;
                padding: 0;
                font-size: 0.75rem;
                line-height: 1.4;
                color: #2563eb;
                text-decoration: none;
                font-weight: 600;
                white-space: nowrap;
            }

                .notification-read-button:hover,
                .mark-notification-read:hover {
                    color: #1d4ed8;
                    text-decoration: underline;
                }

            .notification-dropdown > .border-top {
                background-color: #FFFFFF;
                width: 100%;
            }

                .notification-dropdown > .border-top .dropdown-item {
                    width: 100%;
                    white-space: nowrap;
                    text-align: center;
                    box-sizing: border-box;
                }

            .notification-list::-webkit-scrollbar {
                width: 6px;
            }

            .notification-list::-webkit-scrollbar-track {
                background: #F8FAFC;
            }

            .notification-list::-webkit-scrollbar-thumb {
                background: #CBD5E1;
                border-radius: 10px;
            }

                .notification-list::-webkit-scrollbar-thumb:hover {
                    background: #94A3B8;
                }

            @@media (max-width: 576px) {
                .notification-dropdown {
                    width: 340px;
                    min-width: 340px;
                    max-width: calc(100vw - 20px);
                }
            }


            /* =====================================================
                       CONTENT
                       ===================================================== */

            .teamlead-content {
                padding: 30px;
            }


            /* =====================================================
                       FOOTER
                       ===================================================== */

            .teamlead-footer {
                padding: 18px 30px;
                color: #6b7280;
                font-size: 13px;
                border-top: 1px solid #e5e7eb;
                background: #ffffff;
            }


            /* =====================================================
                       MOBILE
                       ===================================================== */

            @@media (max-width: 768px) {

                .teamlead-sidebar {
                    width: 70px;
                }


                .teamlead-brand {
                    justify-content: center;
                    padding: 0;
                }


                    .teamlead-brand span {
                        display: none;
                    }


                .teamlead-nav {
                    padding-left: 8px;
                    padding-right: 8px;
                }


                .teamlead-section-title {
                    display: none;
                }


                .teamlead-nav-link {
                    justify-content: center;
                    padding: 12px 8px;
                }


                    .teamlead-nav-link span {
                        display: none;
                    }


                    .teamlead-nav-link i {
                        width: auto;
                        font-size: 18px;
                    }


                .teamlead-main {
                    margin-left: 70px;
                }


                .teamlead-topbar {
                    padding: 0 15px;
                }


                .notification-dropdown {
                    position: fixed !important;
                    top: 65px !important;
                    right: 10px !important;
                    left: auto !important;
                    transform: none !important;
                }
            }

    </style>

</head>


<body>


    <!-- =====================================================
         TEAM LEAD SIDEBAR
         ===================================================== -->

    <aside class="teamlead-sidebar">


        <!-- Brand -->

        <div class="teamlead-brand">

            <i class="bi bi-bar-chart-fill me-2"></i>

            <span>
                CRM System
            </span>

        </div>


        <!-- Navigation -->

        <nav class="teamlead-nav">


            <!-- Dashboard -->

            <a asp-controller="TeamLead"
               asp-action="Dashboard"
               class="teamlead-nav-link
                @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard"
                  ? "active"
                  : "")">

                <i class="bi bi-speedometer2"></i>

                <span>
                    Dashboard
                </span>

            </a>


            <!-- =================================================
                 TEAM MANAGEMENT
                 ================================================= -->

            <div class="teamlead-section-title">
                Team Management
            </div>


            <!-- My Team -->

            <a asp-controller="TeamLead"
               asp-action="MyTeam"
               class="teamlead-nav-link
                @(ViewContext.RouteData.Values["action"]?.ToString() == "MyTeam"
                  ? "active"
                  : "")">

                <i class="bi bi-people"></i>

                <span>
                    My Team
                </span>

            </a>


            <!-- Sales Officers -->

            <a asp-controller="TeamLead"
               asp-action="SalesOfficers"
               class="teamlead-nav-link
                @(ViewContext.RouteData.Values["action"]?.ToString() == "SalesOfficers"
                  ? "active"
                  : "")">

                <i class="bi bi-person-badge"></i>

                <span>
                    Sales Officers
                </span>

            </a>


            <!-- =================================================
                 LEAD MANAGEMENT
                 ================================================= -->

            <div class="teamlead-section-title">
                Lead Management
            </div>


            <!-- Leads -->

            <a asp-controller="TeamLead"
               asp-action="Leads"
               class="teamlead-nav-link
                @(ViewContext.RouteData.Values["action"]?.ToString() == "Leads"
                  ? "active"
                  : "")">

                <i class="bi bi-list-check"></i>

                <span>
                    Leads
                </span>

            </a>


            <!-- Follow-ups -->

            <a asp-controller="TeamLead"
               asp-action="FollowUps"
               class="teamlead-nav-link
                @(ViewContext.RouteData.Values["action"]?.ToString() == "FollowUps"
                  ? "active"
                  : "")">

                <i class="bi bi-calendar-check"></i>

                <span>
                    Follow-ups
                </span>

            </a>


            <!-- =================================================
                 ANALYTICS
                 ================================================= -->

            <div class="teamlead-section-title">
                Analytics
            </div>


            <!-- Performance -->

            <a asp-controller="TeamLead"
               asp-action="Performance"
               class="teamlead-nav-link
                @(ViewContext.RouteData.Values["action"]?.ToString() == "Performance"
                  ? "active"
                  : "")">

                <i class="bi bi-graph-up-arrow"></i>

                <span>
                    Performance
                </span>

            </a>


            <!-- Reports -->

            <a asp-controller="TeamLead"
               asp-action="Reports"
               class="teamlead-nav-link
                @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports"
                  ? "active"
                  : "")">

                <i class="bi bi-file-earmark-bar-graph"></i>

                <span>
                    Reports
                </span>

            </a>


            <!-- =================================================
                 ACCOUNT
                 ================================================= -->

            <div class="teamlead-section-title">
                Account
            </div>


            <!-- Profile -->

            <a asp-controller="TeamLead"
               asp-action="Profile"
               class="teamlead-nav-link
                @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile"
                  ? "active"
                  : "")">

                <i class="bi bi-person-circle"></i>

                <span>
                    Profile
                </span>

            </a>


            <!-- Logout -->

            <a asp-controller="Auth"
               asp-action="Logout"
               class="teamlead-nav-link teamlead-logout">

                <i class="bi bi-box-arrow-right"></i>

                <span>
                    Logout
                </span>

            </a>


        </nav>

    </aside>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main class="teamlead-main">


        <!-- =================================================
             TOPBAR
             ================================================= -->

        <header class="teamlead-topbar">


            <!-- Breadcrumb -->

            <div class="teamlead-page-title">

                <span class="home">
                    Dashboard
                </span>

                <span class="separator">
                    /
                </span>

                <span class="current">
                    @ViewData["Title"]
                </span>

            </div>


            <!-- =================================================
                 TOPBAR RIGHT (Admin Style)
                 ================================================= -->

            <div class="d-flex align-items-center">

                <!-- Search -->
                <div class="me-4">

                    <input type="text"
                           class="form-control"
                           placeholder="Search..." />

                </div>

                <!-- Notification Bell -->

                <div class="dropdown me-3">

                    <button class="btn btn-light position-relative"
                            type="button"
                            id="notificationBell"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                        <i class="bi bi-bell fs-5"></i>

                        <span id="notificationBadge"
                              class="position-absolute
                            top-0
                            start-100
                            translate-middle
                            badge
                            rounded-pill
                            bg-danger
                            d-none">

                            0

                        </span>

                    </button>


                    <div class="dropdown-menu
                        dropdown-menu-end
                        shadow
                        border-0
                        notification-dropdown"
                         aria-labelledby="notificationBell">

                        <!-- Header -->

                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            px-3
                            py-2
                            border-bottom">

                            <h6 class="mb-0 fw-semibold">

                                Notifications

                            </h6>

                            <button type="button"
                                    class="btn btn-sm
                                btn-link
                                text-decoration-none
                                p-0"
                                    id="notificationMarkAllBtn">

                                Mark all

                            </button>

                        </div>


                        <!-- Notification List -->

                        <div id="notificationList"
                             class="notification-list">

                            <div class="text-center py-4">

                                <div class="spinner-border
                                    spinner-border-sm
                                    text-primary">
                                </div>

                                <div class="small text-muted mt-2">

                                    Loading notifications...

                                </div>

                            </div>

                        </div>


                        <!-- Footer -->

                        <div class="border-top text-center">

                            <a asp-controller="Notification"
                               asp-action="Index"
                               class="dropdown-item
                                text-center
                                py-2
                                fw-semibold">

                                View All Notifications

                            </a>

                        </div>

                    </div>

                </div>


                <!-- Anti-Forgery Token -->

                <div id="notificationAntiForgeryToken"
                     class="d-none">

                    @Html.AntiForgeryToken()

                </div>

                <!-- Profile -->
                <div class="dropdown">

                    <button class="btn btn-light dropdown-toggle"
                            data-bs-toggle="dropdown">

                        <i class="bi bi-person-circle me-2"></i>

                        @Context.Session.GetString("FullName")

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>

                            <a class="dropdown-item"
                               asp-controller="TeamLead"
                               asp-action="Dashboard">

                                Dashboard

                            </a>

                        </li>

                        <li>

                            <a class="dropdown-item"
                               asp-controller="TeamLead"
                               asp-action="Profile">

                                Profile

                            </a>

                        </li>

                        <li>

                            <hr class="dropdown-divider">

                        </li>

                        <li>

                            <a class="dropdown-item text-danger"
                               asp-controller="Auth"
                               asp-action="Logout">

                                Logout

                            </a>

                        </li>

                    </ul>

                </div>

            </div>


        </header>


        <!-- =================================================
             PAGE CONTENT
             ================================================= -->

        <div class="teamlead-content">

            @RenderBody()

        </div>


        <!-- =================================================
             FOOTER
             ================================================= -->

        <footer class="teamlead-footer">

            © @DateTime.Now.Year CRM System.
            All Rights Reserved.

        </footer>


    </main>


    <!-- =====================================================
         SCRIPTS
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- =====================================================
         Notification JavaScript
         ===================================================== -->

    <script src="~/js/notification.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>