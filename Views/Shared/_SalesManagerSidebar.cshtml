@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="sidebar">

    <!-- Logo -->
    <div class="sidebar-header">

        <h4 class="m-0">
            <i class="bi bi-graph-up-arrow"></i>
            CRM System
        </h4>

    </div>

    <!-- Navigation -->
    <ul class="sidebar-menu">

        <!-- Dashboard -->
        <li>

            <a asp-controller="SalesManager"
               asp-action="Index"
               class="@(currentController == "SalesManager" && currentAction == "Index" ? "active" : "")">

                <i class="bi bi-speedometer2"></i>

                Dashboard

            </a>

        </li>

        <!-- Lead Management -->
        <li class="menu-title">

            Lead Management

        </li>

        <li>

            <a asp-controller="SalesManager"
               asp-action="LeadQueue">

                <i class="bi bi-list-task"></i>

                Lead Queue

            </a>

        </li>

     

        <!-- API Leads -->

<li>

    <a asp-controller="SalesManager"
       asp-action="ApiLeads"
       class="@(currentController == "SalesManager" && currentAction == "ApiLeads" ? "active" : "")">

        <i class="bi bi-cloud-arrow-down-fill"></i>

        API Leads

    </a>

</li>

        <li>

            <a asp-controller="SalesManager"
               asp-action="CreateLead">

                <i class="bi bi-plus-circle-fill"></i>

                Add Lead

            </a>

        </li>

        <li>

            <a asp-controller="SalesManager"
               asp-action="FollowUps">

                <i class="bi bi-telephone-forward-fill"></i>

                Follow-ups

            </a>

        </li>

        <li>

            <a asp-controller="SalesManager"
               asp-action="UnassignedLeads"
               class="@(currentController == "SalesManager" &&
                                              currentAction == "UnassignedLeads"
                                              ? "active"
                                              : "")">

                <i class="bi bi-person-check-fill"></i>

                Assign Leads

            </a>

        </li>

        <li>

            <a asp-controller="SalesManager"
               asp-action="ArchivedLeads">

                <i class="bi bi-archive-fill"></i>

                Archived Leads

            </a>

        </li>

        <!-- Team -->
        <li class="menu-title">

            Team Management

        </li>

        <!-- Sales Officers -->
        <li>

            <a asp-controller="SalesManager"
               asp-action="SalesOfficers"
               class="@(currentController == "SalesManager" && currentAction == "SalesOfficers" ? "active" : "")">

                <i class="bi bi-people-fill"></i>

                Sales Officers

            </a>

        </li>

        <!-- Team Lead Targets -->
        <li>

            <a asp-controller="SalesManager"
               asp-action="TeamLeadTargets"
               class="@(currentController == "SalesManager" && currentAction == "TeamLeadTargets" ? "active" : "")">

                <i class="bi bi-bullseye"></i>

                Team Lead Targets

            </a>

        </li>

        <!-- Performance -->
        <li>

            <a asp-controller="SalesManager"
               asp-action="Performance"
               class="@(currentController == "SalesManager" && currentAction == "Performance" ? "active" : "")">

                <i class="bi bi-bar-chart-fill"></i>

                Performance

            </a>

        </li>

        <!-- Reports -->
        <li>

            <a asp-controller="SalesManager"
               asp-action="Reports"
               class="@(currentController == "SalesManager" && currentAction == "Reports" ? "active" : "")">

                <i class="bi bi-file-earmark-bar-graph-fill"></i>

                Reports

            </a>

        </li>

        <!-- Settings -->
        <li>

            <a asp-controller="SalesManagerSettings"
               asp-action="Index"
               class="@(currentController == "SalesManagerSettings" ? "active" : "")">

                <i class="bi bi-gear-fill"></i>

                Settings

            </a>

        </li>

        <!-- Logout -->
        <li class="mt-auto">

            <a asp-controller="Auth"
               asp-action="Logout"
               class="text-danger">

                <i class="bi bi-box-arrow-right"></i>

                Logout

            </a>

        </li>

    </ul>

</div>