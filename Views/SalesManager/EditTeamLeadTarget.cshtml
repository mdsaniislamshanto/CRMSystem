@model CRMSystem.Models.ViewModels.EditTargetViewModel

@{
    ViewData["Title"] = "Edit Team Lead Target";
    ViewData["Breadcrumb"] = "Edit Team Lead Target";
    Layout = "_SalesManagerLayout";
}

<div class="container-fluid py-4">

    <!-- ===================================================== -->
    <!-- Page Header -->
    <!-- ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between
        align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Edit Team Lead Target
            </h2>

            <p class="text-muted mb-0">
                Update performance target for @Model.UserName.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <a asp-controller="SalesManager"
               asp-action="TeamLeadTargets"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Targets

            </a>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- Validation Summary -->
    <!-- ===================================================== -->

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <!-- ===================================================== -->
    <!-- Edit Target Card -->
    <!-- ===================================================== -->

    <div class="row justify-content-center">

        <div class="col-12 col-xl-8">

            <div class="card border-0 shadow-sm">

                <!-- Card Header -->

                <div class="card-header bg-white border-0 py-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle
                            bg-primary
                            bg-opacity-10
                            text-primary
                            p-3 me-3">

                            <i class="bi bi-pencil-square fs-4"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Target Information
                            </h5>

                            <small class="text-muted">
                                Modify target count or period for the active target.
                            </small>

                        </div>

                    </div>

                </div>


                <!-- Form -->

                <div class="card-body p-4 p-md-5">

                    <form asp-controller="SalesManager"
                          asp-action="EditTeamLeadTarget"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="TargetId" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="UserName" />
                        <input type="hidden" asp-for="UserRole" />

                        <!-- ================================================= -->
                        <!-- Team Lead (Readonly Display) -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Team Lead
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.UserName"
                                   readonly
                                   style="background-color: #e9ecef;" />

                            <div class="form-text">
                                Target recipient cannot be changed.
                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- Target Period -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label asp-for="PeriodType"
                                   class="form-label fw-semibold">

                                Target Period

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <select asp-for="PeriodType"
                                    class="form-select"
                                    id="PeriodType">

                                <option value="1">
                                    Weekly (7 Days)
                                </option>

                                <option value="2">
                                    Monthly (1 Month)
                                </option>

                            </select>

                            <span asp-validation-for="PeriodType"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Select the period type for this target.
                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- Target Count -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <label asp-for="TargetCount"
                                   class="form-label fw-semibold">

                                Target Count

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-hash"></i>
                                </span>

                                <input asp-for="TargetCount"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       placeholder="Enter target count" />

                            </div>

                            <span asp-validation-for="TargetCount"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Target count must be greater than zero.
                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- Date Range (Editable) -->
                        <!-- ================================================= -->

                        <div class="row">

                            <!-- Start Date -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="StartDate"
                                       class="form-label fw-semibold">

                                    Start Date

                                </label>

                                <input asp-for="StartDate"
                                       type="date"
                                       id="StartDate"
                                       class="form-control" />

                                <span asp-validation-for="StartDate"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- End Date -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="EndDate"
                                       class="form-label fw-semibold">

                                    End Date

                                </label>

                                <input asp-for="EndDate"
                                       type="date"
                                       id="EndDate"
                                       class="form-control" />

                                <span asp-validation-for="EndDate"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-12 mb-3">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    You can manually select or adjust the Start Date and End Date as needed.
                                </small>
                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- Information Alert -->
                        <!-- ================================================= -->

                        <div class="alert alert-info border-0 mb-4">

                            <div class="d-flex">

                                <i class="bi bi-info-circle fs-5 me-2"></i>

                                <div>

                                    <strong>
                                        Note
                                    </strong>

                                    <div class="small mt-1">

                                        Modifying this target will adjust the goal for the current period. Completed leads achieved by this Team Lead's team during this period will be evaluated against the updated target.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- Action Buttons -->
                        <!-- ================================================= -->

                        <div class="d-flex flex-wrap
                            justify-content-end
                            gap-2">

                            <a asp-controller="SalesManager"
                               asp-action="TeamLeadTargets"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>

                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const periodSelect = document.getElementById("PeriodType");
            const startDateInput = document.getElementById("StartDate");
            const endDateInput = document.getElementById("EndDate");
            const form = document.querySelector("form");

            function formatDate(d) {
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            function updateEndDateOnPeriodChange() {
                const val = periodSelect.value;
                if (!startDateInput.value) return;

                const parts = startDateInput.value.split('-');
                if (parts.length !== 3) return;
                const start = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));

                if (val === "1" || val === "Weekly") {
                    const end = new Date(start);
                    end.setDate(end.getDate() + 7);
                    endDateInput.value = formatDate(end);
                } else if (val === "2" || val === "Monthly") {
                    const end = new Date(start);
                    end.setMonth(end.getMonth() + 1);
                    endDateInput.value = formatDate(end);
                }
            }

            if (periodSelect) {
                periodSelect.addEventListener("change", updateEndDateOnPeriodChange);
            }

            if (form) {
                form.addEventListener("submit", function (e) {
                    if (startDateInput.value && endDateInput.value) {
                        if (startDateInput.value > endDateInput.value) {
                            e.preventDefault();
                            alert("Start date cannot be after end date.");
                            return false;
                        }
                    }
                });
            }
        });
    </script>
}
