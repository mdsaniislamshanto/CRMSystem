@model List<CRMSystem.Models.ViewModels.SalesManagerFollowUpViewModel>

@{
    ViewData["Title"] = "Follow-ups";
    ViewData["Breadcrumb"] = "Follow-ups";
    Layout = "_SalesManagerLayout";
}

<div class="container-fluid py-4">

    <!-- ==============================
         Page Header
         ============================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Follow-ups
            </h2>

            <p class="text-muted mb-0">
                Monitor follow-ups submitted by Sales Officers.
            </p>
        </div>

        <div>
            <span class="badge bg-primary fs-6 px-3 py-2">
                @Model.Count Follow-up(s)
            </span>
        </div>

    </div>


    <!-- ==============================
         Follow-up Card
         ============================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>

                    <h5 class="fw-semibold">
                        No Follow-ups Found
                    </h5>

                    <p class="text-muted mb-0">
                        No Sales Officer follow-ups are available at the moment.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Lead
                                </th>

                                <th>
                                    Sales Officer
                                </th>

                                <th>
                                    Feedback Submitted
                                </th>

                                <th>
                                    Next Follow-up
                                </th>

                                <th>
                                    Summary
                                </th>

                                <th>
                                    Feedback Status
                                </th>

                                <th>
                                    Follow-up Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var followUp in Model)
                            {
                                <tr>

                                    <!-- Lead -->
                                    <td>

                                        <div class="fw-semibold">
                                            @followUp.LeadName
                                        </div>

                                        <small class="text-muted d-block mb-2">
                                            Lead ID: @followUp.LeadId
                                        </small>

                                        <a asp-controller="SalesManager"
                                           asp-action="FollowUpDetails"
                                           asp-route-id="@followUp.LeadId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-clock-history me-1"></i>

                                            View History

                                        </a>

                                    </td>


                                    <!-- Sales Officer -->

                                    <td>

                                        <div class="fw-semibold">
                                            @followUp.SalesOfficerName
                                        </div>

                                    </td>


                                    <!-- Feedback Submitted Time -->

                                    <td>

                                        <div class="fw-semibold">
                                            @(followUp.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy"))
                                        </div>

                                        <small class="text-muted">
                                            @(followUp.SubmittedAt.ToLocalTime().ToString("hh:mm tt"))
                                        </small>

                                    </td>


                                    <!-- Next Follow-up -->

                                    <td>

                                        <div class="fw-semibold">
                                            @(followUp.FollowUpDate.ToLocalTime().ToString("dd MMM yyyy"))
                                        </div>

                                        <small class="text-muted">
                                            @(followUp.FollowUpDate.ToLocalTime().ToString("hh:mm tt"))
                                        </small>

                                    </td>


                                    <!-- Summary -->

                                    <td style="min-width: 220px;">

                                        <div>
                                            @followUp.Summary
                                        </div>

                                    </td>


                                    <!-- Feedback Status -->

                                    <td>

                                        <span class="badge bg-secondary">

                                            @followUp.FeedbackStatus

                                        </span>

                                    </td>


                                    <!-- Follow-up Status -->

                                    <td>

                                        @if (followUp.IsOverdue)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-exclamation-circle me-1"></i>

                                                Overdue

                                            </span>
                                        }
                                        else if (followUp.IsDueToday)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-clock me-1"></i>

                                                Due Today

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-calendar-check me-1"></i>

                                                Upcoming

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>