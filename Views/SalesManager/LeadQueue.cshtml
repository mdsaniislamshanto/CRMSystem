@model IEnumerable<CRMSystem.Models.ViewModels.LeadViewModel>

@{
    ViewData["Title"] = "Lead Queue";
    Layout = "_SalesManagerLayout";
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Lead Queue
            </h2>

            <p class="text-muted mb-0">
                Active leads waiting for assignment and follow-up.
            </p>

        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Lead Code</th>

                            <th>Lead Name</th>

                            <th>Company</th>

                            <th>Phone</th>

                            <th>Priority</th>

                            <th>Status</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-4">

                                    No active leads found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var lead in Model)
                            {
                                <tr>

                                    <td>@lead.LeadCode</td>

                                    <td>@lead.LeadName</td>

                                    <td>@lead.CompanyName</td>

                                    <td>@lead.Phone</td>

                                    <td>

                                        @switch (lead.Priority)
                                        {
                                            case CRMSystem.Enums.LeadPriority.High:
                                                <span class="badge bg-danger">High</span>
                                                break;

                                            case CRMSystem.Enums.LeadPriority.Medium:
                                                <span class="badge bg-warning text-dark">Medium</span>
                                                break;

                                            default:
                                                <span class="badge bg-success">Low</span>
                                                break;
                                        }

                                    </td>

                                    <td>

                                        <span class="badge bg-primary">

                                            @lead.Status

                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <!-- View -->
                                        <a asp-controller="SalesManager"
                                           asp-action="LeadDetails"
                                           asp-route-id="@lead.LeadId"
                                           class="btn btn-info btn-sm"
                                           title="View">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        @if (lead.Status == CRMSystem.Enums.LeadStatus.New)
                                        {
                                            <!-- Assign -->
                                            <a asp-controller="SalesManager"
                                               asp-action="AssignLead"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-primary btn-sm"
                                               title="Assign">

                                                <i class="bi bi-person-check-fill"></i>

                                            </a>

                                            <!-- Edit -->
                                            <a asp-controller="SalesManager"
                                               asp-action="EditLead"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-warning btn-sm"
                                               title="Edit">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>
                                        }
                                        else if (lead.Status != CRMSystem.Enums.LeadStatus.Completed)
                                        {
                                            <!-- Edit -->
                                            <a asp-controller="SalesManager"
                                               asp-action="EditLead"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-warning btn-sm"
                                               title="Edit">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <!-- Reassign -->
                                            <a asp-controller="SalesManager"
                                               asp-action="ReassignLead"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-secondary btn-sm"
                                               title="Reassign">

                                                <i class="bi bi-arrow-repeat"></i>

                                            </a>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>