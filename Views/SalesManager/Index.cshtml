@model CRMSystem.Models.ViewModels.SalesManagerDashboardViewModel
@{
    ViewData["Title"] = "Sales Manager Dashboard";
    Layout = "_SalesManagerLayout";

    // =====================================================
    // Target Progress Calculation
    // =====================================================

    var targetProgress =
        Model.TotalTarget > 0
            ? (double)Model.TargetFulfilled /
              Model.TotalTarget * 100
            : 0;

    var progressWidth =
        Math.Min(targetProgress, 100);
}

<div class="container-fluid">

    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Sales Manager Dashboard
            </h2>

            <p class="text-muted mb-0">
                Welcome! Monitor lead assignment, sales team performance and SLA compliance.
            </p>

        </div>

    </div>

    <!-- KPI Cards -->
    <div class="row g-4">

        <!-- Total New Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        New Leads Today
                    </h6>

                    <h2 class="fw-bold text-primary">
                        @Model.NewLeadsToday
                    </h2>

                    <small class="text-muted">
                        Created today
                    </small>

                </div>

            </div>

        </div>

        <!-- Unassigned Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Unassigned Leads
                    </h6>

                    <h2 class="fw-bold text-warning">
                        @Model.TotalUnassignedLeads
                    </h2>

                    <small class="text-muted">
                        Waiting for assignment
                    </small>

                </div>

            </div>

        </div>

        <!-- Assigned Today -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Assigned Today
                    </h6>

                    <h2 class="fw-bold text-success">
                        @Model.AssignedToday
                    </h2>

                    <small class="text-muted">
                        Assigned by Sales Manager
                    </small>

                </div>

            </div>

        </div>

        <!-- Completed Today -->
        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Completed Today
                    </h6>

                    <h2 class="fw-bold text-info">
                        @Model.CompletedToday
                    </h2>

                    <small class="text-muted">
                        Successfully completed
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         Target Overview
         ===================================================== -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-light">

            <h5 class="mb-0">

                <i class="bi bi-bullseye me-2"></i>

                Target Overview

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- Total Target -->
                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex align-items-center">

                            <div class="me-3">

                                <i class="bi bi-flag-fill fs-3 text-primary"></i>

                            </div>

                            <div>

                                <small class="text-muted d-block">
                                    Total Target
                                </small>

                                <h3 class="fw-bold mb-0">
                                    @Model.TotalTarget
                                </h3>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Target Fulfilled -->
                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex align-items-center">

                            <div class="me-3">

                                <i class="bi bi-check-circle-fill fs-3 text-success"></i>

                            </div>

                            <div>

                                <small class="text-muted d-block">
                                    Target Fulfilled
                                </small>

                                <h3 class="fw-bold mb-0">
                                    @Model.TargetFulfilled
                                </h3>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Target Progress -->
                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex align-items-center">

                            <div class="me-3">

                                <i class="bi bi-graph-up-arrow fs-3 text-info"></i>

                            </div>

                            <div>

                                <small class="text-muted d-block">
                                    Target Progress
                                </small>

                                <h3 class="fw-bold mb-0">
                                    @targetProgress.ToString("0.##")%
                                </h3>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Progress Bar -->

            <div class="mt-4">

                <div class="d-flex justify-content-between align-items-center mb-2">

                    <span class="fw-semibold">
                        Overall Achievement
                    </span>

                    <span class="text-muted">
                        @Model.TargetFulfilled / @Model.TotalTarget
                    </span>

                </div>

                <div class="progress"
                     role="progressbar"
                     aria-label="Sales Manager target progress"
                     aria-valuenow="@progressWidth"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     style="height: 12px;">

                    <div class="progress-bar bg-success"
                         style="width: @progressWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Today's Action Center -->
    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-warning-subtle">

            <h5 class="mb-0">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                Today's Action Center

            </h5>

        </div>

        <div class="card-body">

            <!-- Pending Assignments -->

            <div class="alert alert-warning mb-3
                d-flex justify-content-between align-items-center">

                <div>

                    <i class="bi bi-person-plus-fill me-2"></i>

                    <strong>@Model.PendingAssignments</strong>
                    Lead(s) are waiting for assignment.

                </div>

                @if (Model.PendingAssignments > 0)
                {
                    <a asp-controller="SalesManager"
                       asp-action="UnassignedLeads"
                       class="btn btn-sm btn-warning">

                        View

                    </a>
                }

            </div>


            <!-- Acceptance SLA -->

            <div class="alert alert-danger mb-3
                d-flex justify-content-between align-items-center">

                <div>

                    <i class="bi bi-clock-history me-2"></i>

                    <strong>@Model.MissedAcceptanceSLA</strong>
                    Sales Officer(s) missed the
                    1-hour Lead Acceptance SLA.

                </div>

                @if (Model.MissedAcceptanceSLA > 0)
                {
                    <a asp-controller="SalesManager"
                       asp-action="Performance"
                       class="btn btn-sm btn-danger">

                        View

                    </a>
                }

            </div>


            <!-- First Feedback SLA -->

            <div class="alert alert-danger mb-3
                d-flex justify-content-between align-items-center">

                <div>

                    <i class="bi bi-chat-left-text-fill me-2"></i>

                    <strong>@Model.MissedFirstFeedbackSLA</strong>
                    Sales Officer(s) missed the
                    3-hour First Feedback SLA.

                </div>

                @if (Model.MissedFirstFeedbackSLA > 0)
                {
                    <a asp-controller="SalesManager"
                       asp-action="Performance"
                       class="btn btn-sm btn-danger">

                        View

                    </a>
                }

            </div>


            <!-- Due Follow-ups -->

            <div class="alert alert-info mb-3
                d-flex justify-content-between align-items-center">

                <div>

                    <i class="bi bi-calendar-check-fill me-2"></i>

                    <strong>@Model.DueFollowUps</strong>
                    Follow-up(s) are due today.

                </div>

                @if (Model.DueFollowUps > 0)
                {
                    <a asp-controller="SalesManager"
                       asp-action="FollowUps"
                       class="btn btn-sm btn-info text-white">

                        View

                    </a>
                }

            </div>


            <!-- Archived Today -->

            <div class="alert alert-secondary mb-0
                d-flex justify-content-between align-items-center">

                <div>

                    <i class="bi bi-archive-fill me-2"></i>

                    <strong>@Model.ArchivedToday</strong>
                    Lead(s) archived today.

                </div>

                @if (Model.ArchivedToday > 0)
                {
                    <a asp-controller="SalesManager"
                       asp-action="ArchivedLeads"
                       class="btn btn-sm btn-secondary">

                        View

                    </a>
                }

            </div>

        </div>

    </div>


    <!-- Auto Assignment Status -->
    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header">

            <h5 class="mb-0">

                <i class="bi bi-robot me-2"></i>

                Auto Assignment Status

            </h5>

        </div>

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>

                <h6 class="mb-1">
                    Current Status
                </h6>

                <small class="text-muted">
                    Automatic lead assignment for Sales Officers.
                </small>

            </div>

            <span class="badge @(Model.AutoAssignmentEnabled ? "bg-success" : "bg-danger") fs-6">

                @(Model.AutoAssignmentEnabled ? "ON" : "OFF")

            </span>

        </div>

    </div>

</div>