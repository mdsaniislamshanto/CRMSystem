@model CRMSystem.Models.ViewModels.LeadViewModel

@{
    ViewData["Title"] = "Lead Details";
    Layout = "_SalesManagerLayout";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow-sm border-0">

                <div class="card-header">

                    <h4 class="mb-0">
                        Lead Details
                    </h4>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Lead Code</label>
                            <p>@Model.LeadCode</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Lead Name</label>
                            <p>@Model.LeadName</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Company</label>
                            <p>@Model.CompanyName</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Phone</label>
                            <p>@Model.Phone</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Email</label>
                            <p>@Model.Email</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Profession</label>
                            <p>@Model.Profession</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Source</label>
                            <p>@Model.Source</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Priority</label>
                            <p>@Model.Priority</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Status</label>
                            <p>@Model.Status</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Follow-up Date</label>
                            <p>@Model.FollowUpDate</p>
                        </div>

                        <div class="col-12 mb-3">
                            <label class="fw-bold">Address</label>
                            <p>@Model.Address</p>
                        </div>

                        <div class="col-12 mb-3">
                            <label class="fw-bold">Description</label>
                            <p>@Model.Description</p>
                        </div>

                       

                    </div>

                    <hr />

                    <a asp-action="LeadQueue"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>

                        Back to Lead Queue

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>