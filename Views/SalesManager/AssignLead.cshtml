@model CRMSystem.Models.ViewModels.AssignLeadViewModel

@{
    ViewData["Title"] = "Assign Lead";
    Layout = "_SalesManagerLayout";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-header">

                    <h4 class="mb-0">

                        Assign Lead

                    </h4>

                </div>

                <div class="card-body">

                    <form asp-action="AssignLead"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="LeadId" type="hidden" />

                        <div class="mb-3">

                            <label class="form-label">

                                Lead Code

                            </label>

                            <input asp-for="LeadCode"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">

                                Lead Name

                            </label>

                            <input asp-for="LeadName"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="mb-4">

                            <label asp-for="SalesOfficerId"
                                   class="form-label">

                            </label>

                            <select asp-for="SalesOfficerId"
                                    asp-items="Model.SalesOfficers"
                                    class="form-select">

                                <option value="">

                                    -- Select Sales Officer --

                                </option>

                            </select>

                            <span asp-validation-for="SalesOfficerId"
                                  class="text-danger">

                            </span>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="LeadQueue"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-person-check-fill me-1"></i>

                                Assign Lead

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}