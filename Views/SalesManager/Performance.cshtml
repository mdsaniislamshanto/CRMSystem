    <script>
            document.addEventListener("DOMContentLoaded", function() {
                loadSLATrend();
            });

            async function loadSLATrend() {
                const canvas = document.getElementById("slaTrendCanvas");

                if (!canvas) {
                    return;
                }

                try {
                    const currentUrl = new URL(window.location.href);

                    const range = currentUrl.searchParams.get("Range");
                    const fromDate = currentUrl.searchParams.get("FromDate");
                    const toDate = currentUrl.searchParams.get("ToDate");

                    const params = new URLSearchParams();

                    if (range) {
                        params.append("Range", range);
                    }

                    if (fromDate) {
                        params.append("FromDate", fromDate);
                    }

                    if (toDate) {
                        params.append("ToDate", toDate);
                    }

                    const response =
                        await fetch(`/SalesManager/SLATrend?${params.toString()}`);

                    if (!response.ok) {
                        throw new Error("Unable to load SLA trend.");
                    }

                    const data = await response.json();

                    const slaRangeBadge =
                        document.getElementById("slaTrendRange");

                    if (slaRangeBadge) {
                        slaRangeBadge.textContent =
                            formatSLARange(range || "ThisMonth");
                    }

                    if (!Array.isArray(data) || data.length === 0) {
                        showSLATrendState(
                            "No SLA Trend Data",
                            "There is no SLA data available for the selected period.",
                            "bi-graph-down"
                        );
                        return;
                    }

                    renderSLATrendChart(canvas, data);
                }
                catch (error) {
                    console.error("SLA Trend Error:", error);

                    showSLATrendState(
                        "Unable to Load SLA Trend",
                        "Please refresh the page and try again.",
                        "bi-exclamation-triangle"
                    );
                }
            }

            function renderSLATrendChart(canvas, data) {
                const existingChart = Chart.getChart(canvas);

                if (existingChart) {
                    existingChart.destroy();
                }

                const labels = data.map(item =>
                    formatSLATrendDate(item.date)
                );

                const acceptanceData = data.map(item =>
                    Number(item.acceptanceSLAComplianceRate) || 0
                );

                const firstFeedbackData = data.map(item =>
                    Number(item.firstFeedbackSLAComplianceRate) || 0
                );

                const nextFeedbackData = data.map(item =>
                    Number(item.nextFeedbackSLAComplianceRate) || 0
                );

                new Chart(canvas, {
                    type: "line",

                    data: {
                        labels: labels,

                        datasets: [
                            {
                                label: "Acceptance SLA",
                                data: acceptanceData,
                                borderColor: "#6b8fd6",
                                backgroundColor: "#6b8fd6",
                                pointBackgroundColor: "#6b8fd6",
                                pointBorderColor: "#ffffff",
                                borderWidth: 2.5,
                                tension: 0.35,
                                pointRadius: data.length > 20 ? 1.5 : 3,
                                pointHoverRadius: 5,
                                fill: false
                            },
                            {
                                label: "First Feedback SLA",
                                data: firstFeedbackData,
                                borderColor: "#4f9f86",
                                backgroundColor: "#4f9f86",
                                pointBackgroundColor: "#4f9f86",
                                pointBorderColor: "#ffffff",
                                borderWidth: 2.5,
                                tension: 0.35,
                                pointRadius: data.length > 20 ? 1.5 : 3,
                                pointHoverRadius: 5,
                                fill: false
                            },
                            {
                                label: "Next Feedback SLA",
                                data: nextFeedbackData,
                                borderColor: "#b58b45",
                                backgroundColor: "#b58b45",
                                pointBackgroundColor: "#b58b45",
                                pointBorderColor: "#ffffff",
                                borderWidth: 2.5,
                                borderDash: [6, 4],
                                tension: 0.35,
                                pointRadius: data.length > 20 ? 1.5 : 3,
                                pointHoverRadius: 5,
                                fill: false
                            }
                        ]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        interaction: {
                            mode: "index",
                            intersect: false
                        },

                        animation: {
                            duration: 500
                        },

                        plugins: {
                            legend: {
                                display: false
                            },

                            tooltip: {
                                mode: "index",
                                intersect: false,
                                padding: 10,

                                callbacks: {
                                    label: function(context) {
                                        const value =
                                            Number(context.parsed.y ?? 0);

                                        return context.dataset.label
                                            + ": "
                                            + value.toFixed(2)
                                            + "%";
                                    }
                                }
                            }
                        },

                        scales: {
                            x: {
                                grid: {
                                    display: false
                                },

                                ticks: {
                                    maxTicksLimit: 12,
                                    autoSkip: true,
                                    maxRotation: 0,
                                    padding: 8
                                }
                            },

                            y: {
                                min: 0,
                                max: 100,

                                ticks: {
                                    stepSize: 20,
                                    callback: function(value) {
                                        return value + "%";
                                    },

                                    padding: 8
                                },

                                grid: {
                                    color: "rgba(15, 23, 42, 0.08)"
                                }
                            }
                        },

                        elements: {
                            line: {
                                capBezierPoints: true
                            },

                            point: {
                                hitRadius: 10
                            }
                        }
                    }
                });
            }

            function formatSLARange(range) {
                switch (range) {
                    case "Today":
                        return "Today";

                    case "ThisWeek":
                        return "This Week";

                    case "ThisMonth":
                        return "This Month";

                    case "Custom":
                        return "Custom Range";

                    default:
                        return range || "Selected Range";
                }
            }

            function formatSLATrendDate(dateValue) {
                const date = new Date(dateValue);

                if (isNaN(date.getTime())) {
                    return dateValue;
                }

                return date.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric"
                });
            }

            function showSLATrendState(title, message, icon) {
                const canvas = document.getElementById("slaTrendCanvas");

                if (!canvas) {
                    return;
                }

                const existingChart = Chart.getChart(canvas);

                if (existingChart) {
                    existingChart.destroy();
                }

                const parent = canvas.parentElement;

                parent.innerHTML = `
                                        <div class="d-flex justify-content-center align-items-center h-100">
                                            <div class="text-center text-muted">
                                                <div class="pm-empty-icon mx-auto">
                                                    <i class="bi ${icon}"></i>
                                                </div>
                                                <h6 class="fw-semibold mt-3 mb-1">${title}</h6>
                                                <p class="mb-0 small">${message}</p>
                                            </div>
                                        </div>
                                    `;
            }
    </script>


