<script>
    document.addEventListener("DOMContentLoaded", function() {

        const rangeSelect =
            document.getElementById("rangeSelect");

        const customDateFields =
            document.getElementById("customDateFields");

        const loading =
            document.getElementById("trendLoading");

        const empty =
            document.getElementById("trendEmpty");

        const trendContainer =
            document.getElementById("performanceTrendContainer");

        const trendCanvas =
            document.getElementById("performanceTrendCanvas");

        const trendRangeLabel =
            document.getElementById("trendRangeLabel");

        function toggleCustomDates() {
            if (!rangeSelect || !customDateFields) {
                return;
            }

            customDateFields.style.display =
                rangeSelect.value === "Custom"
                    ? "block"
                    : "none";
        }

        function buildQuery() {
            const params = new URLSearchParams();

            if (rangeSelect) {
                params.append("Range", rangeSelect.value);
            }

            const fromDateInput =
                document.querySelector('input[name="FromDate"]');

            const toDateInput =
                document.querySelector('input[name="ToDate"]');

            if (fromDateInput && fromDateInput.value) {
                params.append("FromDate", fromDateInput.value);
            }

            if (toDateInput && toDateInput.value) {
                params.append("ToDate", toDateInput.value);
            }

            return params.toString();
        }

        function destroyPerformanceTrendChart() {
            if (!trendCanvas) {
                return;
            }

            const existingChart =
                Chart.getChart(trendCanvas);

            if (existingChart) {
                existingChart.destroy();
            }
        }

        function drawChart(data) {
            if (!trendCanvas) {
                return;
            }

            destroyPerformanceTrendChart();

            if (!Array.isArray(data) || data.length === 0) {
                if (trendContainer) {
                    trendContainer.style.display = "none";
                }

                if (empty) {
                    empty.classList.remove("d-none");
                }

                return;
            }

            if (trendContainer) {
                trendContainer.style.display = "block";
            }

            if (empty) {
                empty.classList.add("d-none");
            }

            const labels =
                data.map(item => formatDate(item.date));

            const assignedData =
                data.map(item => Number(item.assignedLeads) || 0);

            const acceptedData =
                data.map(item => Number(item.acceptedLeads) || 0);

            const completedData =
                data.map(item => Number(item.completedLeads) || 0);

            const feedbackData =
                data.map(item => Number(item.feedbacks) || 0);

            const overdueData =
                data.map(item => Number(item.overdueFollowUps) || 0);

            new Chart(trendCanvas, {
                type: "line",

                data: {
                    labels: labels,

                    datasets: [
                        {
                            label: "Assigned",
                            data: assignedData,
                            borderColor: "#6b8fd6",
                            backgroundColor: "#6b8fd6",
                            pointBackgroundColor: "#6b8fd6",
