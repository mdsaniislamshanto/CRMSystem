                                pointRadius: data.length > 20 ? 1.5 : 3,
                                pointHoverRadius: 5,
                                fill: false
                            },
                            {
                                label: "Accepted",
                                data: acceptedData,
                                borderColor: "#4f9f86",
                                backgroundColor: "#4f9f86",
                                pointBackgroundColor: "#4f9f86",
                                pointBorderColor: "#ffffff",
                                borderWidth: 2.5,
                                tension: 0.35,
                                pointRadius: data.length > 20 ? 1.5 : 3,
                                pointHoverRadius: 5,
                                fill: false
                            },
                            {
                                label: "Completed",
                                data: completedData,
                                borderColor: "#2f8f6b",
                                backgroundColor: "#2f8f6b",
                                pointBackgroundColor: "#2f8f6b",
                                pointBorderColor: "#ffffff",
                                borderWidth: 2.5,
                                tension: 0.35,
                                pointRadius: data.length > 20 ? 1.5 : 3,
                                pointHoverRadius: 5,
                                fill: false
                            },
                            {
