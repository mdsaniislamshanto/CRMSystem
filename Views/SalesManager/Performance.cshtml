            function formatCompletionRange(range) {
                switch (range) {
                    case "Today":
                        return "Today";

                    case "ThisWeek":
                        return "This Week";

                    case "ThisMonth":
                        return "This Month";

                    case "Custom":
                        return "Custom Range";

                    default:
                        return range || "Selected Range";
