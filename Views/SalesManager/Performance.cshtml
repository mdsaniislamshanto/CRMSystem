    <!-- =========================================================
         COMPLETION TREND SCRIPT
         ========================================================= -->

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                loadCompletionTrend();
            });

            async function loadCompletionTrend() {
                try {
                    const params = new URLSearchParams(window.location.search);

                    const range = params.get("Range") || "ThisMonth";
                    const fromDate = params.get("FromDate") || "";
                    const toDate = params.get("ToDate") || "";

                    const rangeBadge = document.getElementById("completionTrendRange");

                    if (rangeBadge) {
                        rangeBadge.textContent = formatCompletionRange(range);
                    }

                    const url =
                        '@Url.Action("GetCompletionTrend", "SalesManager")'
                        + '?Range=' + encodeURIComponent(range)
                        + '&FromDate=' + encodeURIComponent(fromDate)
                        + '&ToDate=' + encodeURIComponent(toDate);

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("Failed to load completion trend.");
                    }

                    const data = await response.json();

                    renderCompletionTrend(data);
                }
                catch (error) {
                    console.error("Completion Trend Error:", error);
                    showCompletionTrendError();
                }
            }

            function renderCompletionTrend(data) {
                const canvas = document.getElementById("completionTrendChart");

                if (!canvas) {
                    return;
                }

                const existingChart = Chart.getChart(canvas);

                if (existingChart) {
                    existingChart.destroy();
                }

                if (!Array.isArray(data) || data.length === 0) {
                    showCompletionTrendEmpty();
                    return;
                }

                const labels = data.map(item =>
                    formatCompletionTrendDate(item.date)
                );

                const assignedData = data.map(item =>
                    Number(item.assignedLeads) || 0
                );

                const acceptedData = data.map(item =>
                    Number(item.acceptedLeads) || 0
                );

                const completedData = data.map(item =>
