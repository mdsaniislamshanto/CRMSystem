                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    interaction: {
                        mode: "index",
                        intersect: false
                    },

                    animation: {
                        duration: 500
                    },

                    plugins: {
                        legend: {
                            position: "top",
                            align: "start",

                            labels: {
                                usePointStyle: true,
                                pointStyle: "circle",
                                padding: 18,
                                boxWidth: 8
                            }
                        },

                        tooltip: {
                            mode: "index",
                            intersect: false,
                            padding: 10
                        }
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            ticks: {
                                maxTicksLimit: 12,
                                autoSkip: true,
                                maxRotation: 0,
                                padding: 8
                            }
                        },

                        y: {
                            beginAtZero: true,

                            ticks: {
                                precision: 0,
                                padding: 8
                            },

                            grid: {
                                color: "rgba(108, 117, 125, 0.12)"
                            }
                        }
                    },

                    elements: {
                        line: {
                            capBezierPoints: true
                        },

                        point: {
                            hitRadius: 10
                        }
                    }
                }
            });
        }

        function formatDate(dateString) {
            const date = new Date(dateString);

            if (Number.isNaN(date.getTime())) {
                return "";
            }

            return date.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric"
            });
        }

        async function loadPerformanceTrend() {
            if (!loading || !empty || !trendContainer) {
                return;
            }

            loading.classList.remove("d-none");
            empty.classList.add("d-none");
            trendContainer.style.display = "none";

            try {
                const url =
                    '@Url.Action("PerformanceTrend", "SalesManager")'
                    + "?"
                    + buildQuery();

                const response =
                    await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                if (!response.ok) {
                    throw new Error(
                        "Performance trend request failed. HTTP status: "
                        + response.status
                    );
                }

                const data = await response.json();

                console.log(
                    "Performance Trend Data:",
                    data
                );

                drawChart(data);
            }
            catch (error) {
                console.error(
                    "Performance Trend Error:",
                    error
                );

                destroyPerformanceTrendChart();

                trendContainer.style.display = "none";
                empty.classList.remove("d-none");
            }
            finally {
                loading.classList.add("d-none");
            }
        }

        if (rangeSelect) {
            rangeSelect.addEventListener(
                "change",
                function() {
                    toggleCustomDates();

                    if (trendRangeLabel) {
                        const selectedText =
                            rangeSelect.options[
                                rangeSelect.selectedIndex
                            ].text;

                        trendRangeLabel.textContent =
                            selectedText;
                    }

                    loadPerformanceTrend();
                }
            );
        }

        toggleCustomDates();
        loadPerformanceTrend();
    });
</script>



<script>
    document.addEventListener("DOMContentLoaded", function() {

        updateExportExcelLink();

    });


    // =========================================================
    // Update Excel Export URL
    // =========================================================

    function updateExportExcelLink() {

        const exportButton =
            document.getElementById(
                "exportExcelButton"
            );


        if (!exportButton) {
            return;
        }


        // -----------------------------------------------------
        // Read Current URL Parameters
        // -----------------------------------------------------

        const params =
            new URLSearchParams(
                window.location.search
            );


        const range =
            params.get("Range") || "ThisMonth";


        const fromDate =
            params.get("FromDate") || "";


        const toDate =
            params.get("ToDate") || "";


        // -----------------------------------------------------
        // Build Export URL
        // -----------------------------------------------------

        const exportUrl =
            '@Url.Action(
                                                                "ExportPerformanceExcel",
                                                                "SalesManager"
                )'
            + '?Range='
            + encodeURIComponent(range)
            + '&FromDate='
            + encodeURIComponent(fromDate)
            + '&ToDate='
            + encodeURIComponent(toDate);


        // -----------------------------------------------------
        // Set Button URL
        // -----------------------------------------------------

        exportButton.href =
            exportUrl;

    }
</script>