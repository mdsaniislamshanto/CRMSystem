        .performance-page .pm-chart-wrap.pm-chart-tall {
            height: 330px;
        }
    }

    @@media (max-width: 767.98px) {
        .performance-page {
            padding-left: .75rem !important;
            padding-right: .75rem !important;
        }

            .performance-page > .pm-filter-card,
            .performance-page > .alert,
            .performance-page > .row,
            .performance-page > .card {
                margin-bottom: 1.5rem !important;
            }

            .performance-page .pm-page-header {
                align-items: flex-start !important;
                margin-bottom: 1.35rem !important;
            }

                .performance-page .pm-page-header > div:last-child {
                    display: none;
                }

            .performance-page .pm-export-actions {
                gap: .5rem;
            }

            .performance-page .pm-export-btn {
                flex: 1 1 auto;
                min-width: 0;
            }

            .performance-page .pm-chart-wrap,
            .performance-page .pm-chart-wrap.pm-chart-tall {
                height: 300px;
            }

            .performance-page .card-header {
                padding: 1rem !important;
            }

            .performance-page .card-body {
                padding: 1rem !important;
            }

            .performance-page .pm-trend-card .card-body {
                padding: .75rem !important;
            }

            .performance-page .pm-table-card .card-body {
                padding: 0 !important;
            }
    }

    @@media (max-width: 575.98px) {
        .performance-page .pm-chart-wrap,
        .performance-page .pm-chart-wrap.pm-chart-tall {
            height: 270px;
        }

        .performance-page .pm-chart-toolbar {
            align-items: flex-start;
        }

            .performance-page .pm-chart-toolbar .badge {
                margin-top: .25rem;
            }

        .performance-page .pm-chart-legend {
            gap: .5rem .85rem;
        }

        .performance-page .pm-export-actions {
            width: 100%;
        }

        .performance-page .pm-export-btn {
            min-height: 38px;
        }
    }
</style>

<div class="container-fluid py-4 performance-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4 pm-page-header">

        <div>

            <h2 class="fw-bold mb-1">
                Sales Officer Performance
            </h2>

            <p class="text-muted mb-0">
                Monitor Sales Officer productivity, feedback activity,
                SLA performance and follow-up status.
            </p>

        </div>

        <div>

            <span class="badge bg-primary fs-6 px-3 py-2">

                <i class="bi bi-graph-up-arrow me-1"></i>

                Performance

            </span>

        </div>

    </div>


    <!-- =====================================================
         DATE RANGE FILTER
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4 pm-filter-card">

        <div class="card-body">

            <form method="get"
                  asp-controller="SalesManager"
                  asp-action="Performance">

                <div class="row g-3 align-items-end">

                    <!-- Range -->

                    <div class="col-md-4 col-lg-3">

                        <label class="form-label fw-semibold">
                            Date Range
                        </label>

                        <select id="rangeSelect"
                                name="Range"
                                class="form-select">

                            <option value="Today"
                                    selected="@(filter.Range == "Today")">
                                Today
                            </option>

                            <option value="ThisWeek"
                                    selected="@(filter.Range == "ThisWeek")">
                                This Week
                            </option>

                            <option value="ThisMonth"
                                    selected="@(filter.Range == "ThisMonth")">
                                This Month
                            </option>

                            <option value="Custom"
                                    selected="@(filter.Range == "Custom")">
                                Custom Range
                            </option>

                        </select>

                    </div>


                    <!-- Custom Dates -->

                    <div id="customDateFields"
                         class="col-md-5 col-lg-5"
                         style="display:@(
                         filter.Range == "Custom"
                             ? "block"
                             : "none"
                                                                                     );">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    From Date
                                </label>

                                <input type="date"
                                       name="FromDate"
                                       class="form-control"
                                       value="@(
                                       filter.FromDate?.ToString("yyyy-MM-dd")
                                                                                                                           )" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    To Date
                                </label>

                                <input type="date"
                                       name="ToDate"
                                       class="form-control"
                                       value="@(
                                       filter.ToDate?.ToString("yyyy-MM-dd")
                                                                                                                           )" />

                            </div>

                        </div>

                    </div>


                    <!-- Apply -->

                    <div class="col-md-3 col-lg-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-funnel me-1"></i>

                            Apply Filter

                        </button>

                    </div>

                    <!-- Export actions: UI-only wrapper -->
                    <div class="col-12 col-lg-auto pm-export-actions">

                        <!-- Excel Export button -->
                        <a id="exportExcelButton"
                           href="@Url.Action("ExportPerformanceExcel", "SalesManager")"
                           class="pm-export-btn pm-export-excel">
                            <i class="bi bi-file-earmark-excel"></i>
                            <span>Export Excel</span>
                        </a>

                        <!-- PDF Export button -->
                        <a asp-controller="SalesManager"
                           asp-action="ExportPerformancePdf"
                           asp-route-Range="@Context.Request.Query["Range"].ToString()"
                           asp-route-FromDate="@Context.Request.Query["FromDate"].ToString()"
                           asp-route-ToDate="@Context.Request.Query["ToDate"].ToString()"
                           class="pm-export-btn pm-export-pdf">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>Export PDF</span>
                        </a>

                    </div>

     


                    <!-- Current Range -->

                    <div class="col-md-12 col-lg-2">

                        <div class="text-muted small">
                            Current Range
                        </div>

                        <div class="fw-semibold">
                            @rangeText
                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         TEMP DATA ERROR
         ===================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =====================================================
         PERFORMANCE HIGHLIGHTS
         ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- =================================================
             TOP PERFORMER
             ================================================= -->

        <div class="col-xl-6">

            <div class="card border-0 shadow-sm h-100 overflow-hidden pm-highlight-card pm-highlight-success">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center">

                            <div class="
                                rounded-circle
                                bg-success-subtle
                                text-success
                                d-flex
                                align-items-center
                                justify-content-center
                                me-3"
                                 style="
                                width:44px;
                                height:44px;
                                ">

                                <i class="bi bi-trophy-fill fs-5"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Top Performer
                                </h5>

                                <small class="text-muted">
                                    Best overall performance in @rangeText
                                </small>

                            </div>

                        </div>


                        <span class="badge bg-success-subtle text-success px-3 py-2">
                            <i class="bi bi-star-fill me-1"></i>
                            Best
                        </span>

                    </div>

                </div>


                <div class="card-body">

                    @if (topPerformer == null)
                    {
                        <div class="text-center py-4">

                            <i class="bi bi-person-x fs-1 text-muted"></i>

                            <h6 class="fw-semibold mt-3">
                                No Performance Data
                            </h6>

                            <p class="text-muted small mb-0">
                                No Sales Officer performance data is
                                available for the selected period.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-start mb-4">

                            <div class="d-flex align-items-center">

                                <div class="
                                    rounded-circle
                                    bg-success
                                    text-white
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    me-3"
                                     style="
                                    width:56px;
                                    height:56px;
                                    ">

                                    <i class="bi bi-person-fill fs-4"></i>

                                </div>

                                <div>

                                    <h4 class="fw-bold mb-1">
                                        @topPerformer.SalesOfficerName
                                    </h4>

                                    <small class="text-muted">
                                        Officer ID:
                                        @topPerformer.SalesOfficerId
                                    </small>

                                </div>

                            </div>


                            <div class="text-end">

                                <div class="text-muted small">
                                    Performance Score
                                </div>

                                <div class="display-6 fw-bold text-success">
                                    @topPerformer.PerformanceScore.ToString("0.00")%
                                </div>

                            </div>

                        </div>


                        <!-- Performance Score Progress -->

                        <div class="mb-4">

                            <div class="d-flex justify-content-between mb-1">

                                <small class="text-muted">
                                    Overall Performance
                                </small>

                                <small class="fw-semibold text-success">
                                    @topPerformer.PerformanceScore.ToString("0.00")%
                                </small>

                            </div>

                            <div class="progress"
                                 style="height:8px;">

                                <div class="progress-bar bg-success"
                                     role="progressbar"
                                     style="width:@(
                                     Math.Min(
                                         Math.Max(
                                             topPerformer.PerformanceScore,
                                             0
                                         ),
                                         100
                                     )
                                                                                                                                     )%;">
                                </div>

                            </div>

                        </div>


                        <!-- Metrics -->

                        <div class="row g-3">

                            <!-- Completion -->

                            <div class="col-6">

                                <div class="bg-light rounded-3 p-3 h-100">

                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted small">
                                            Completion
                                        </span>

                                        <i class="bi bi-check2-circle text-success"></i>

                                    </div>

                                    <div class="fw-bold fs-5 mt-1">
                                        @topPerformer.CompletionRate.ToString("0.00")%
                                    </div>

                                </div>

                            </div>


                            <!-- First Feedback -->

                            <div class="col-6">

                                <div class="bg-light rounded-3 p-3 h-100">

                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted small">
                                            First Feedback SLA
                                        </span>

                                        <i class="bi bi-stopwatch text-primary"></i>

                                    </div>

                                    <div class="fw-bold fs-5 mt-1">
                                        @topPerformer.FirstFeedbackSLAComplianceRate.ToString("0.00")%
                                    </div>

                                </div>

                            </div>


                            <!-- Follow-up -->

                            <div class="col-6">

                                <div class="bg-light rounded-3 p-3 h-100">

                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted small">
                                            Follow-up
                                        </span>

                                        <i class="bi bi-calendar-check text-info"></i>

                                    </div>

                                    <div class="fw-bold fs-5 mt-1">
                                        @topPerformer.FollowUpTimelinessRate.ToString("0.00")%
                                    </div>

                                </div>

                            </div>


                            <!-- Acceptance SLA -->

                            <div class="col-6">

                                <div class="bg-light rounded-3 p-3 h-100">

                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted small">
                                            Acceptance SLA
                                        </span>

                                        <i class="bi bi-lightning-charge text-warning"></i>

                                    </div>

                                    <div class="fw-bold fs-5 mt-1">
                                        @topPerformer.AcceptanceSLAComplianceRate.ToString("0.00")%
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Footer -->

                        <div class="
                            d-flex
                            justify-content-between
                            align-items-center
                            border-top
                            mt-4
                            pt-3">

                            <small class="text-muted">

                                <i class="bi bi-check-circle me-1"></i>

                                @topPerformer.CompletedLeads completed
                                of @topPerformer.AcceptedLeads accepted leads

                            </small>

                            <small class="fw-semibold text-success">

                                @topPerformer.TotalFeedbacks feedbacks

                            </small>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- =================================================
             NEEDS ATTENTION
             ================================================= -->

        <div class="col-xl-6">

            <div class="card border-0 shadow-sm h-100 overflow-hidden pm-highlight-card pm-highlight-danger">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center">

                            <div class="
                                rounded-circle
                                bg-danger-subtle
                                text-danger
                                d-flex
                                align-items-center
                                justify-content-center
                                me-3"
                                 style="
                                width:44px;
                                height:44px;
                                ">

                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Needs Attention
                                </h5>

                                <small class="text-muted">
                                    Highest operational risk in @rangeText
                                </small>

                            </div>

                        </div>


                        <span class="badge bg-danger-subtle text-danger px-3 py-2">
                            <i class="bi bi-shield-exclamation me-1"></i>
                            Attention
                        </span>

                    </div>

                </div>


                <div class="card-body">

                    @if (needsAttention == null)
                    {
                        <div class="text-center py-4">

                            <i class="bi bi-check-circle fs-1 text-success"></i>

                            <h6 class="fw-semibold mt-3">
                                No Attention Required
                            </h6>

                            <p class="text-muted small mb-0">
                                No Sales Officer requires attention
                                for the selected period.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-start mb-4">

                            <div class="d-flex align-items-center">

                                <div class="
                                    rounded-circle
                                    bg-danger
                                    text-white
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    me-3"
                                     style="
                                    width:56px;
                                    height:56px;
                                    ">

                                    <i class="bi bi-person-fill-exclamation fs-4"></i>

                                </div>

                                <div>

                                    <h4 class="fw-bold mb-1">
                                        @needsAttention.SalesOfficerName
                                    </h4>

                                    <small class="text-muted">
                                        Officer ID:
                                        @needsAttention.SalesOfficerId
                                    </small>

                                </div>

                            </div>


                            <div class="text-end">

                                <div class="text-muted small">
                                    Attention Score
                                </div>

                                <div class="display-6 fw-bold text-danger">
                                    @needsAttention.PerformanceScore.ToString("0.00")
                                </div>

                            </div>

                        </div>


                        <!-- Risk Indicators -->

                        <div class="row g-3">

                            <!-- SLA Missed -->

                            <div class="col-6">

                                <div class="
                                    border
                                    border-danger-subtle
                                    rounded-3
                                    p-3
                                    h-100">

                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted small">
                                            SLA Missed
                                        </span>

                                        <i class="bi bi-exclamation-circle text-danger"></i>

                                    </div>

                                    <div class="fw-bold fs-5 mt-1 text-danger">

                                        @(
                                            needsAttention.AcceptanceSLAMissed
                                            +
                                            needsAttention.FirstFeedbackSLAMissed
                                            +
                                            needsAttention.NextFeedbackSLAMissed
                                        )

                                    </div>

                                    <small class="text-muted">
                                        Acceptance + Feedback
                                    </small>

                                </div>

                            </div>


                            <!-- Overdue -->

                            <div class="col-6">

                                <div class="
                                    border
                                    border-danger-subtle
                                    rounded-3
                                    p-3
                                    h-100">

                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted small">
                                            Overdue Follow-ups
                                        </span>

                                        <i class="bi bi-clock-history text-danger"></i>

                                    </div>

                                    <div class="fw-bold fs-5 mt-1 text-danger">
                                        @needsAttention.OverdueFollowUps
                                    </div>

                                    <small class="text-muted">
                                        Require attention
                                    </small>

                                </div>

                            </div>


                            <!-- Completion -->

                            <div class="col-6">

                                <div class="bg-light rounded-3 p-3 h-100">

                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted small">
                                            Completion
                                        </span>

                                        <i class="bi bi-check2-circle text-warning"></i>

                                    </div>

                                    <div class="
                                        fw-bold
                                        fs-5
                                        mt-1
                                        @(needsAttention.CompletionRate < 50
                                            ? "text-danger"
                                            : "text-warning-emphasis")">

                                        @needsAttention.CompletionRate.ToString("0.00")%

                                    </div>

                                </div>

                            </div>


                            <!-- Acceptance -->

                            <div class="col-6">

                                <div class="bg-light rounded-3 p-3 h-100">

                                    <div class="d-flex justify-content-between">

                                        <span class="text-muted small">
                                            Acceptance Rate
                                        </span>

                                        <i class="bi bi-person-check text-warning"></i>

                                    </div>

                                    <div class="
                                        fw-bold
                                        fs-5
                                        mt-1
                                        @(needsAttention.AcceptanceRate < 50
                                            ? "text-danger"
                                            : "text-warning-emphasis")">

                                        @needsAttention.AcceptanceRate.ToString("0.00")%

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- SLA Details -->

                        <div class="
                            border-top
                            mt-4
                            pt-3">

                            <div class="row g-2">

                                <div class="col-4">

                                    <div class="text-center">

                                        <div class="small text-muted">
                                            Acceptance
                                        </div>

                                        <div class="fw-bold text-danger">
                                            @needsAttention.AcceptanceSLAMissed
                                        </div>

                                    </div>

                                </div>


                                <div class="col-4">

                                    <div class="text-center">

                                        <div class="small text-muted">
                                            First Feedback
                                        </div>

                                        <div class="fw-bold text-danger">
                                            @needsAttention.FirstFeedbackSLAMissed
                                        </div>

                                    </div>

                                </div>


                                <div class="col-4">

                                    <div class="text-center">

                                        <div class="small text-muted">
                                            Next Feedback
                                        </div>

                                        <div class="fw-bold text-danger">
                                            @needsAttention.NextFeedbackSLAMissed
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY CARDS
         ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Officers -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Sales Officers
                            </div>

                            <h3 class="fw-bold mt-2 mb-0">
                                @totalOfficers
                            </h3>

                        </div>

                        <div class="text-primary fs-3">

                            <i class="bi bi-people-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Assigned -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Assigned Leads
                            </div>

                            <h3 class="fw-bold mt-2 mb-0">
                                @totalAssigned
                            </h3>

                        </div>

                        <div class="text-info fs-3">

                            <i class="bi bi-person-lines-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Feedback -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Total Feedbacks
                            </div>

                            <h3 class="fw-bold mt-2 mb-0">
                                @totalFeedbacks
                            </h3>

                        </div>

                        <div class="text-success fs-3">

                            <i class="bi bi-chat-left-text-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Overdue -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Overdue Follow-ups
                            </div>

                            <h3 class="fw-bold mt-2 mb-0
                                @(totalOverdue > 0
                                    ? "text-danger"
                                    : "text-success")">

                                @totalOverdue

                            </h3>

                        </div>

                        <div class="
                            @(totalOverdue > 0
                                ? "text-danger"
                                : "text-success")
                            fs-3">

                            <i class="bi bi-clock-history"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PERFORMANCE OVERVIEW
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-3">

                    <div class="text-muted small">
                        Selected Period
                    </div>

                    <div class="fw-bold mt-1">
                        @rangeText
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Overall Acceptance Rate
                    </div>

                    <div class="fw-bold mt-1">
                        @totalAcceptanceRate.ToString("0.00")%
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Completed Leads
                    </div>

                    <div class="fw-bold mt-1">
                        @totalCompleted
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Team Completion Rate
                    </div>

                    <div class="fw-bold mt-1">
                        @totalCompletionRate.ToString("0.00")%
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PERFORMANCE TREND
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-semibold mb-1">

                        <i class="bi bi-graph-up me-2 text-primary"></i>

                        Performance Trend

                    </h5>

                    <small class="text-muted">

                        Daily team performance for the selected date range.

                    </small>

                </div>


                <span id="trendRangeLabel"
                      class="badge bg-primary-subtle text-primary">

                    @rangeText

                </span>

            </div>

        </div>


