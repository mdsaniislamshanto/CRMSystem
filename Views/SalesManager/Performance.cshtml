@model List<CRMSystem.Models.ViewModels.SalesOfficerPerformanceViewModel>

@{
    ViewData["Title"] = "Sales Officer Performance";
    ViewData["Breadcrumb"] = "Performance";
    Layout = "_SalesManagerLayout";

    var filter =
        ViewData["PerformanceFilter"]
        as CRMSystem.Models.ViewModels.PerformanceFilterViewModel
        ?? new CRMSystem.Models.ViewModels.PerformanceFilterViewModel();

    var topPerformer =
        ViewData["TopPerformer"]
        as CRMSystem.Models.ViewModels.PerformanceHighlightViewModel;

    var needsAttention =
        ViewData["NeedsAttention"]
        as CRMSystem.Models.ViewModels.PerformanceHighlightViewModel;

    var totalOfficers = Model.Count;

    var totalAssigned =
        Model.Sum(x => x.TotalAssignedLeads);

    var totalAccepted =
        Model.Sum(x => x.AcceptedLeads);

    var totalFeedbacks =
        Model.Sum(x => x.TotalFeedbacks);

    var totalOverdue =
        Model.Sum(x => x.OverdueFollowUps);

    var totalCompleted =
        Model.Sum(x => x.CompletedLeads);

    var totalAcceptanceRate =
        totalAssigned > 0
            ? (double)totalAccepted / totalAssigned * 100
            : 0;

    var totalCompletionRate =
        totalAccepted > 0
            ? (double)totalCompleted / totalAccepted * 100
            : 0;

    var rangeText =
        filter.Range switch
        {
            "Today" => "Today",
            "ThisWeek" => "This Week",
            "Custom" => "Custom Range",
            _ => "This Month"
        };
}



