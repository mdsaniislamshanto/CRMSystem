@model List<CRMSystem.Models.ViewModels.SalesOfficerListViewModel>

@{
    ViewData["Title"] = "Sales Officers";
    ViewData["Breadcrumb"] = "Sales Officers";
    Layout = "_SalesManagerLayout";

    var totalOfficers = Model.Count;
    var activeOfficers = Model.Count(x => x.IsActive);
    var inactiveOfficers = Model.Count(x => !x.IsActive);

    var totalAssigned = Model.Sum(x => x.AssignedLeads);
    var totalAccepted = Model.Sum(x => x.AcceptedLeads);
    var totalPending = Model.Sum(x => x.PendingAcceptance);
    var totalFeedbacks = Model.Sum(x => x.TotalFeedbacks);
    var totalOverdue = Model.Sum(x => x.OverdueFollowUps);
}

<div class="container-fluid py-4">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Sales Officers
            </h2>

            <p class="text-muted mb-0">
                Monitor your sales team, workload and follow-up activity.
            </p>
        </div>

        <div>
            <span class="badge bg-primary px-3 py-2">
                <i class="bi bi-people me-1"></i>
                @totalOfficers Officer@(totalOfficers != 1 ? "s" : "")
            </span>
        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TEAM SUMMARY -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Total Officers -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Total Officers
                        </div>

                        <h3 class="fw-bold mb-0 mt-2">
                            @totalOfficers
                        </h3>
                    </div>

                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-people fs-4 text-primary"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- Active Officers -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Active Officers
                        </div>

                        <h3 class="fw-bold text-success mb-0 mt-2">
                            @activeOfficers
                        </h3>
                    </div>

                    <div class="bg-success bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-person-check fs-4 text-success"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- Assigned Leads -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Assigned Leads
                        </div>

                        <h3 class="fw-bold mb-0 mt-2">
                            @totalAssigned
                        </h3>
                    </div>

                    <div class="bg-info bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-list-check fs-4 text-info"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- Overdue Follow-ups -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Overdue Follow-ups
                        </div>

                        <h3 class="fw-bold text-danger mb-0 mt-2">
                            @totalOverdue
                        </h3>
                    </div>

                    <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-clock-history fs-4 text-danger"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TEAM ACTIVITY SUMMARY -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-semibold mb-1">
                        Team Activity
                    </h5>

                    <small class="text-muted">
                        Overall workload and engagement summary
                    </small>
                </div>

            </div>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- Accepted -->
                <div class="col-md-4">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Accepted Leads
                        </span>

                        <strong>
                            @totalAccepted
                        </strong>

                    </div>

                    @{
                        var acceptanceRate =
                            totalAssigned > 0
                                ? (double)totalAccepted / totalAssigned * 100
                                : 0;
                    }

                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width: @acceptanceRate.ToString("0.##")%;">
                        </div>
                    </div>

                    <small class="text-muted">
                        @acceptanceRate.ToString("0.0")% acceptance rate
                    </small>

                </div>


                <!-- Pending -->
                <div class="col-md-4">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Pending Acceptance
                        </span>

                        <strong class="text-warning">
                            @totalPending
                        </strong>

                    </div>

                    @{
                        var pendingRate =
                            totalAssigned > 0
                                ? (double)totalPending / totalAssigned * 100
                                : 0;
                    }

                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-warning"
                             role="progressbar"
                             style="width: @pendingRate.ToString("0.##")%;">
                        </div>
                    </div>

                    <small class="text-muted">
                        @pendingRate.ToString("0.0")% awaiting response
                    </small>

                </div>


                <!-- Feedback -->
                <div class="col-md-4">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Total Feedbacks
                        </span>

                        <strong class="text-success">
                            @totalFeedbacks
                        </strong>

                    </div>

                    <div class="d-flex align-items-center mt-3">

                        <i class="bi bi-chat-left-text text-success me-2"></i>

                        <span class="text-muted">
                            Team feedback activity
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SALES OFFICER TABLE -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="row align-items-center g-3">

                <div class="col-md-6">

                    <h5 class="fw-semibold mb-1">
                        Sales Officer Performance
                    </h5>

                    <small class="text-muted">
                        Current workload and activity of your sales team.
                    </small>

                </div>


                <div class="col-md-6">

                    <div class="d-flex justify-content-md-end gap-2">

                        <!-- Search -->
                        <div class="input-group"
                             style="max-width: 260px;">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="officerSearch"
                                   class="form-control"
                                   placeholder="Search officer..." />

                        </div>


                        <!-- Status Filter -->
                        <select id="statusFilter"
                                class="form-select"
                                style="max-width: 150px;">

                            <option value="all">
                                All Status
                            </option>

                            <option value="active">
                                Active
                            </option>

                            <option value="inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="officerTable">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Sales Officer
                            </th>

                            <th>
                                Contact
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-center">
                                Assigned
                            </th>

                            <th class="text-center">
                                Accepted
                            </th>

                            <th class="text-center">
                                Pending
                            </th>

                            <th class="text-center">
                                Feedback
                            </th>

                            <th class="text-center">
                                Overdue
                            </th>

                            <th class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var officer in Model)
                            {
                                var acceptancePercentage =
                                    officer.AssignedLeads > 0
                                        ? (double)officer.AcceptedLeads /
                                          officer.AssignedLeads * 100
                                        : 0;

                                <tr class="officer-row"
                                    data-name="@officer.FullName.ToLowerInvariant()"
                                    data-code="@officer.EmployeeCode.ToLowerInvariant()"
                                    data-status="@(officer.IsActive ? "active" : "inactive")">

                                    <!-- Officer -->
                                    <td class="ps-4">

                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrWhiteSpace(officer.ProfileImage))
                                            {
                                                <img src="@officer.ProfileImage"
                                                     alt="@officer.FullName"
                                                     class="rounded-circle me-3"
                                                     style="width:42px;height:42px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary bg-opacity-10
                                                    text-primary d-flex align-items-center
                                                    justify-content-center me-3"
                                                     style="width:42px;height:42px;">

                                                    <i class="bi bi-person fs-5"></i>

                                                </div>
                                            }


                                            <div>

                                                <div class="fw-semibold">
                                                    @officer.FullName
                                                </div>

                                                <small class="text-muted">
                                                    @officer.EmployeeCode
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Contact -->
                                    <td>

                                        <div class="small">
                                            @officer.Email
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(officer.PhoneNumber))
                                        {
                                            <small class="text-muted">
                                                @officer.PhoneNumber
                                            </small>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (officer.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success">
                                                <i class="bi bi-circle-fill me-1"
                                                   style="font-size:6px;"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                                <i class="bi bi-circle-fill me-1"
                                                   style="font-size:6px;"></i>
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <!-- Assigned -->
                                    <td class="text-center">

                                        <span class="badge bg-primary bg-opacity-10 text-primary">
                                            @officer.AssignedLeads
                                        </span>

                                    </td>


                                    <!-- Accepted -->
                                    <td class="text-center">

                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            @officer.AcceptedLeads
                                        </span>

                                        <div class="small text-muted mt-1">
                                            @acceptancePercentage.ToString("0.0")%
                                        </div>

                                    </td>


                                    <!-- Pending -->
                                    <td class="text-center">

                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            @officer.PendingAcceptance
                                        </span>

                                    </td>


                                    <!-- Feedback -->
                                    <td class="text-center">

                                        <span class="badge bg-info bg-opacity-10 text-info">
                                            @officer.TotalFeedbacks
                                        </span>

                                    </td>


                                    <!-- Overdue -->
                                    <td class="text-center">

                                        @if (officer.OverdueFollowUps > 0)
                                        {
                                            <span class="badge bg-danger">
                                                @officer.OverdueFollowUps
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success">
                                                0
                                            </span>
                                        }

                                    </td>


                                    <!-- Action -->
                                    <td class="text-center">

                                        <a href="@Url.Action(
                                                                                       "SalesOfficerDetails",
                                                                                       "SalesManager",
                                                                                       new { id = officer.UserId })"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-people fs-1 d-block mb-3"></i>

                                        <h6 class="fw-semibold">
                                            No Sales Officers Found
                                        </h6>

                                        <p class="mb-0">
                                            No Sales Officers are currently available.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- SEARCH & FILTER SCRIPT -->
<!-- ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("officerSearch");

        const statusFilter =
            document.getElementById("statusFilter");

        const rows =
            document.querySelectorAll(".officer-row");


        function filterOfficers() {

            const search =
                searchInput.value
                    .toLowerCase()
                    .trim();

            const status =
                statusFilter.value;


            rows.forEach(function (row) {

                const name =
                    row.dataset.name || "";

                const code =
                    row.dataset.code || "";

                const rowStatus =
                    row.dataset.status || "";


                const matchesSearch =
                    name.includes(search) ||
                    code.includes(search);

                const matchesStatus =
                    status === "all" ||
                    rowStatus === status;


                row.style.display =
                    matchesSearch && matchesStatus
                        ? ""
                        : "none";

            });

        }


        searchInput.addEventListener(
            "input",
            filterOfficers
        );


        statusFilter.addEventListener(
            "change",
            filterOfficers
        );

    });

</script>