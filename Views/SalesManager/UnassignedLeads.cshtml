@model IEnumerable<CRMSystem.Models.ViewModels.UnassignedLeadViewModel>

@{
    ViewData["Title"] = "Assign Leads";
    Layout = "_SalesManagerLayout";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Assign Leads
            </h2>

            <p class="text-muted mb-0">
                Leads waiting for Sales Officer assignment.
            </p>

        </div>

        <div>

            <span class="badge bg-primary fs-6">
                @Model.Count() Unassigned Lead(s)
            </span>

        </div>

    </div>


    <!-- Leads Table -->

    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-check-circle-fill text-success"
                       style="font-size: 50px;">
                    </i>

                    <h5 class="mt-3">
                        No Unassigned Leads
                    </h5>

                    <p class="text-muted">
                        All available leads have already been assigned.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>Lead Code</th>

                                <th>Lead Name</th>

                                <th>Company</th>

                                <th>Phone</th>

                                <th>Source</th>

                                <th>Priority</th>

                                <th>Created</th>

                                <th>Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var lead in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @lead.LeadCode
                                        </strong>
                                    </td>

                                    <td>
                                        @lead.LeadName
                                    </td>

                                    <td>
                                        @(lead.CompanyName ?? "-")
                                    </td>

                                    <td>
                                        @lead.Phone
                                    </td>

                                    <td>
                                        @lead.Source
                                    </td>

                                    <td>

                                        @switch (lead.Priority)
                                        {
                                            case CRMSystem.Enums.LeadPriority.High:

                                                <span class="badge bg-danger">
                                                    High
                                                </span>

                                                break;

                                            case CRMSystem.Enums.LeadPriority.Medium:

                                                <span class="badge bg-warning text-dark">
                                                    Medium
                                                </span>

                                                break;

                                            case CRMSystem.Enums.LeadPriority.Low:

                                                <span class="badge bg-success">
                                                    Low
                                                </span>

                                                break;

                                            default:

                                                <span class="badge bg-secondary">
                                                    @lead.Priority
                                                </span>

                                                break;
                                        }

                                    </td>

                                    <td>
                                        @lead.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>

                                    <td>

                                        <a asp-controller="SalesManager"
                                           asp-action="AssignLead"
                                           asp-route-id="@lead.LeadId"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-person-check-fill me-1"></i>

                                            Assign

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>